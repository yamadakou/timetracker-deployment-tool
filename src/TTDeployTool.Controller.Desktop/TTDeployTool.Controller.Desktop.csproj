<Project Sdk="Microsoft.NET.Sdk">
  <!--
    デスクトップアプリ（WinUI 3、単一プロジェクト MSIX。詳細設計 docs/design/desktop/desktop-app.md）。
    Windows でしかビルドできないため TTDeployTool.sln には入れず、TTDeployTool.Desktop.slnx と CI の desktop ジョブでビルドする。
    画面の状態と操作は TTDeployTool.Controller.Desktop.Core（Linux でもテストできる）に置き、ここは画面と OS の機能だけにする。
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>TTDeployTool.Controller.Desktop</RootNamespace>
    <AssemblyName>ttdeploytool-desktop</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <!-- バンドルでは x64 と arm64 をそれぞれビルドするため、プラットフォームに合わせて実行環境を決める（自己完結のビルドに必要） -->
    <RuntimeIdentifier Condition="'$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform.ToLowerInvariant())' == 'arm64'">win-arm64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- パッケージの言語（マニフェストの Resource は x-generate にして、ビルドがこの言語で生成する） -->
    <DefaultLanguage>ja-JP</DefaultLanguage>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- 利用者の PC に .NET と Windows App SDK のランタイムを求めない（詳細設計 8.1） -->
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!--
      サインインに使うアプリ登録のクライアント ID（詳細設計 5.1・Q3）。空なら Azure.Identity の既定（開発用）を使う。
      オーナーがアプリ登録を用意したら、ビルドで /p:DesktopClientId=<ID> を渡す
    -->
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="DesktopClientId" Value="$(DesktopClientId)" />
  </ItemGroup>
  <!--
    UI テストの System Test（.github/workflows/desktop-system-test.yml）のビルドだけ、/p:UiTestSignIn=true で Azure CLI のサインインを使う
    （Services/AzureCliSignInService.cs。docs/design/desktop/desktop-ui-tests.md の 7）。CI の desktop ジョブとリリースでは指定しない
  -->
  <!-- 1 つだけ起動するため、XAML が生成する Main を使わず、Program.cs の Main で起動する（docs/design/desktop/desktop-jobs.md の 5.1） -->
  <PropertyGroup>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(UiTestSignIn)' == 'true'">
    <DefineConstants>$(DefineConstants);UITEST_SIGNIN</DefineConstants>
  </PropertyGroup>
  <!--
    CI の UI テスト（ci.yml の desktop-ui ジョブ）のビルドだけ、/p:UiTestMock=true で、モックのサインインと Azure（TTDeployTool.Controller.Desktop.Fixtures）を使う
    （docs/design/desktop/desktop-ui-tests.md の 6.2）。モックのプロジェクトはこのときだけ参照するため、Store に出すパッケージには入らない
  -->
  <PropertyGroup Condition="'$(UiTestMock)' == 'true'">
    <DefineConstants>$(DefineConstants);UITEST_MOCK</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(UiTestMock)' == 'true'">
    <ProjectReference Include="..\TTDeployTool.Controller.Desktop.Fixtures\TTDeployTool.Controller.Desktop.Fixtures.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\*.png" />
    <Content Include="Assets\*.ico" />
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>
  <!-- Visual Studio で MSIX の作成と発行のメニューを出す（テンプレートと同じ） -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)' != 'true' and '$(EnableMsixTooling)' == 'true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)' != 'true' and '$(EnableMsixTooling)' == 'true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Azure.Identity.Broker" Version="1.7.0" />
    <!-- 通知領域のアイコン（WinUI 3 と Windows App SDK に API が無いため。D15） -->
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.4.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <!-- 予定のデプロイのパスワードの暗号化（DPAPI。docs/design/desktop/desktop-jobs.md の 6.7） -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
    <!-- 表（列の幅・順序・▽ の絞り込み。MIT。docs/design/desktop/desktop-tables.md の 9・10） -->
    <PackageReference Include="WinUI.TableView" Version="1.5.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\TTDeployTool.Controller.Desktop.Core\TTDeployTool.Controller.Desktop.Core.csproj" />
  </ItemGroup>
</Project>
