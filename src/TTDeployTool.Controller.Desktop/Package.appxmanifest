<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX のマニフェスト（詳細設計 8.1）。Identity の Name と Publisher、PublisherDisplayName は、Partner Center でアプリ名を予約した後に
  その値に置き換える（Store が認定の後に署名し直すため、証明書は要らない）。Version はリリースのタグから X.Y.Z.0 を渡す。
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="TTDeployTool"
    Publisher="CN=TTDeployTool"
    Version="0.1.0.0" />

  <mp:PhoneIdentity PhoneProductId="5f3c0d1e-6b0a-4b7e-9a35-1d9b2c7e4a10" PhonePublisherId="00000000-0000-0000-0000-000000000000"/>

  <Properties>
    <DisplayName>TTDeployTool</DisplayName>
    <PublisherDisplayName>TTDeployTool</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate"/>
  </Resources>

  <Applications>
    <Application Id="App"
      Executable="$targetnametoken$.exe"
      EntryPoint="$targetentrypoint$">
      <uap:VisualElements
        DisplayName="TTDeployTool"
        Description="Timetracker の検証環境を Azure Container Apps にデプロイ・確認・削除し、ローカル検証用の docker-compose を作ります。"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
      <!--
        ジョブの終わりの通知を押したときに、このアプリを起動する（Windows App SDK の AppNotificationManager。docs/design/desktop-jobs.md の 5.1）。
        CLSID は、このアプリの通知の起動のためだけに作ったもの
      -->
      <Extensions>
        <desktop:Extension Category="windows.toastNotificationActivation">
          <desktop:ToastNotificationActivation ToastActivatorCLSID="7296C92E-E434-44FA-A613-F0F10A07CC01" />
        </desktop:Extension>
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:ExeServer Executable="ttdeploytool-desktop.exe" DisplayName="TTDeployTool" Arguments="----AppNotificationActivated:">
              <com:Class Id="7296C92E-E434-44FA-A613-F0F10A07CC01" />
            </com:ExeServer>
          </com:ComServer>
        </com:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <!-- WinUI 3 のデスクトップアプリに必要な制限付き機能（Store への提出で用途を説明する） -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
