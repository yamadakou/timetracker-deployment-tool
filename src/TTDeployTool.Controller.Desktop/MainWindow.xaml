<?xml version="1.0" encoding="utf-8"?>
<!-- 画面は ViewModel（TTDeployTool.Controller.Desktop.Core）のプロパティとコマンドに結び付けるだけにする（詳細設計 3.2・7） -->
<Window
    x:Class="TTDeployTool.Controller.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TTDeployTool.Controller.Desktop"
    xmlns:vm="using:TTDeployTool.Controller.Desktop.Core.ViewModels"
    xmlns:jobs="using:TTDeployTool.Controller.Desktop.Core.Jobs"
    Title="TTDeployTool">

    <Grid x:Name="Root">
        <Grid.Resources>
            <!-- 文字列の一覧の 1 行（TextBlock にして、UI Automation とスクリーン リーダーが各行を読めるようにする） -->
            <DataTemplate x:Key="LineTemplate" x:DataType="x:String">
                <TextBlock Text="{x:Bind}" TextWrapping="Wrap" />
            </DataTemplate>
            <!-- 表の見出し（押すと並べ替え。「▽」で絞り込みを開く。docs/design/desktop-wizard.md の 7） -->
            <Style x:Key="HeaderButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="4,2" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <!-- デプロイ・削除のジョブの進み具合、ログ、結果 -->
            <DataTemplate x:Key="JobTemplate" x:DataType="vm:JobViewModel">
                <StackPanel Spacing="4" Margin="0,8">
                    <StackPanel Orientation="Horizontal"><TextBlock AutomationProperties.AutomationId="Job.Title" Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Title}" /><TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text=": " /><TextBlock AutomationProperties.AutomationId="Job.Status" Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind StatusText, Mode=OneWay}" /></StackPanel>
                    <ProgressBar AutomationProperties.AutomationId="Job.Progress" IsIndeterminate="True" Visibility="{x:Bind IsRunning, Mode=OneWay}" />
                    <TextBlock AutomationProperties.AutomationId="Job.Step" Text="{x:Bind StepText, Mode=OneWay}" />
                    <TextBlock AutomationProperties.AutomationId="Job.Note" Text="{x:Bind Note, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                    <TextBlock AutomationProperties.AutomationId="Job.Error" Text="{x:Bind Error, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                    <TextBlock Text="{x:Bind PersistenceSummary, Mode=OneWay}" TextWrapping="Wrap" />
                    <TextBlock AutomationProperties.AutomationId="Job.Expiry" Text="{x:Bind ExpirySummary, Mode=OneWay}" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind DeletionSummary, Mode=OneWay}" TextWrapping="Wrap" />
                    <HyperlinkButton Content="{x:Bind Endpoint, Mode=OneWay}" NavigateUri="{x:Bind Endpoint, Mode=OneWay}"
                                     Visibility="{x:Bind HasEndpoint, Mode=OneWay}" />
                    <ItemsControl AutomationProperties.AutomationId="Job.Logs" ItemsSource="{x:Bind Logs}" FontFamily="Consolas" ItemTemplate="{StaticResource LineTemplate}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button AutomationProperties.AutomationId="Job.Copy" Content="Markdown でコピー" Command="{x:Bind CopyCommand}" />
                        <TextBlock VerticalAlignment="Center" Text="{x:Bind CopyMessage, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </DataTemplate>
            <!-- ウィザードの完了の表示のジョブ（状態・進み具合・結果だけ。ログは実行状況の画面で見る。No.70） -->
            <DataTemplate x:Key="JobSummaryTemplate" x:DataType="vm:JobViewModel">
                <StackPanel Spacing="4">
                    <TextBlock AutomationProperties.AutomationId="WizardJob.Status" Text="{x:Bind StatusText, Mode=OneWay}" />
                    <ProgressBar IsIndeterminate="True" Visibility="{x:Bind IsRunning, Mode=OneWay}" />
                    <TextBlock AutomationProperties.AutomationId="WizardJob.Step" Text="{x:Bind StepText, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind Note, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                    <TextBlock AutomationProperties.AutomationId="WizardJob.Error" Text="{x:Bind Error, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                    <TextBlock Text="{x:Bind ExpirySummary, Mode=OneWay}" TextWrapping="Wrap" />
                    <HyperlinkButton AutomationProperties.AutomationId="WizardJob.Endpoint" Content="{x:Bind Endpoint, Mode=OneWay}" NavigateUri="{x:Bind Endpoint, Mode=OneWay}"
                                     Visibility="{x:Bind HasEndpoint, Mode=OneWay}" />
                </StackPanel>
            </DataTemplate>
            <!-- ジョブの画面の 1 件（進み具合と、取り消し・一時停止・再開・停止・予定の変更。詳細設計 desktop-jobs.md の 4.1） -->
            <DataTemplate x:Key="JobRowTemplate" x:DataType="vm:JobViewModel">
                <StackPanel Spacing="8" Padding="0,0,0,12" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                    <ContentControl Content="{x:Bind}" ContentTemplate="{StaticResource JobTemplate}" HorizontalContentAlignment="Stretch" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind IsActive, Mode=OneWay}">
                        <Button AutomationProperties.AutomationId="Job.Cancel" Content="取り消し" Command="{x:Bind CancelCommand}" />
                        <Button AutomationProperties.AutomationId="Job.Pause" Content="一時停止" Command="{x:Bind PauseCommand}" />
                        <Button AutomationProperties.AutomationId="Job.Resume" Content="再開" Command="{x:Bind ResumeCommand}" />
                        <Button AutomationProperties.AutomationId="Job.Stop" Content="停止（今の手順の後で止める）" Command="{x:Bind StopCommand}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind IsActive, Mode=OneWay}">
                        <DatePicker AutomationProperties.AutomationId="Job.EditDate" Header="予定の日付" Date="{x:Bind EditDate, Mode=TwoWay}" />
                        <TimePicker AutomationProperties.AutomationId="Job.EditTime" Header="時刻" ClockIdentifier="24HourClock" Time="{x:Bind EditTime, Mode=TwoWay}" />
                        <Button AutomationProperties.AutomationId="Job.Reschedule" Content="予定を変える" VerticalAlignment="Bottom" Command="{x:Bind RescheduleCommand}" />
                    </StackPanel>
                </StackPanel>
            </DataTemplate>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <InfoBar x:Name="UpdateBar" Severity="Informational" IsClosable="True"
                     Title="更新があります" Message="Microsoft Store から新しい版を導入できます。" />
            <!-- 終わっていないジョブの状況（どの画面にも出す。詳細設計 desktop-jobs.md の 4.4） -->
            <InfoBar AutomationProperties.AutomationId="Jobs.Banner" AutomationProperties.Name="{x:Bind ViewModel.Queue.Summary, Mode=OneWay}" Severity="Informational" IsOpen="True" IsClosable="False"
                     Title="ジョブ" Message="{x:Bind ViewModel.Queue.Summary, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasRunningJob, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button AutomationProperties.AutomationId="Jobs.BannerShow" Content="ジョブを見る" Click="OnShowJobs" />
                </InfoBar.ActionButton>
            </InfoBar>
        </StackPanel>

        <NavigationView Grid.Row="1" x:Name="Nav" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
                        SelectionChanged="OnNavigationChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem AutomationProperties.AutomationId="Nav.Target" Content="サインイン" Tag="target" Icon="Contact" IsSelected="True" />
                <NavigationViewItem AutomationProperties.AutomationId="Nav.Deployments" Content="デプロイの一覧" Tag="deployments" Icon="AllApps" IsEnabled="{x:Bind ViewModel.SignIn.IsSignedIn, Mode=OneWay}" />
                <NavigationViewItem AutomationProperties.AutomationId="Nav.Wizard" Content="新しくデプロイ" Tag="wizard" Icon="Upload" IsEnabled="{x:Bind ViewModel.SignIn.IsSignedIn, Mode=OneWay}" />
                <NavigationViewItem x:Name="JobsNavItem" AutomationProperties.AutomationId="Nav.Jobs" Content="ジョブの一覧" Tag="jobs" Icon="List" IsEnabled="{x:Bind ViewModel.SignIn.IsSignedIn, Mode=OneWay}" />
                <NavigationViewItem AutomationProperties.AutomationId="Nav.DryRun" Content="ローカル検証（Dry-run）" Tag="dryrun" Icon="Save" />

            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem AutomationProperties.AutomationId="Nav.AppSettings" Content="設定" Tag="settings" Icon="Setting" />
            </NavigationView.FooterMenuItems>

            <ScrollViewer Padding="24">
                <!-- 画面（Tag が画面の名前。Core の Pages と同じ） -->
                <Grid x:Name="PagesHost">
                    <!-- サインイン（サブスクリプションの一覧は、ウィザードの ① で選ぶ。docs/design/desktop-wizard.md の 2） -->
                    <StackPanel x:Name="TargetPanel" Tag="target" Spacing="12" MaxWidth="900" HorizontalAlignment="Left">
                        <TextBlock AutomationProperties.AutomationId="Panel.Target" Style="{StaticResource SubtitleTextBlockStyle}" Text="Azure へのサインイン" />
                        <TextBlock AutomationProperties.AutomationId="SignIn.Account" Text="{x:Bind ViewModel.SignIn.AccountDisplay, Mode=OneWay}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button AutomationProperties.AutomationId="SignIn.SignIn" Content="サインイン" Command="{x:Bind ViewModel.SignIn.SignInCommand}" Style="{StaticResource AccentButtonStyle}" />
                            <Button AutomationProperties.AutomationId="SignIn.SignOut" Content="サインアウト" Command="{x:Bind ViewModel.SignIn.SignOutCommand}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ViewModel.SignIn.Busy.IsBusy, Mode=OneWay}"><ProgressRing IsActive="{x:Bind ViewModel.SignIn.Busy.IsBusy, Mode=OneWay}" Width="20" Height="20" /><TextBlock AutomationProperties.AutomationId="SignIn.Busy" VerticalAlignment="Center" Text="{x:Bind ViewModel.SignIn.Busy.Text, Mode=OneWay}" /></StackPanel>
                        <InfoBar AutomationProperties.AutomationId="SignIn.Error" AutomationProperties.Name="{x:Bind ViewModel.SignIn.Error, Mode=OneWay}" Severity="Error" IsOpen="True" IsClosable="False" Message="{x:Bind ViewModel.SignIn.Error, Mode=OneWay}"
                                 Visibility="{x:Bind ViewModel.SignIn.HasError, Mode=OneWay}" />
                        <TextBlock TextWrapping="Wrap" Text="サインインすると「デプロイの一覧」が使えます。デプロイ先のサブスクリプションは「新しくデプロイ」で選びます。" />
                        <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ViewModel.Target.Busy.IsBusy, Mode=OneWay}"><ProgressRing IsActive="{x:Bind ViewModel.Target.Busy.IsBusy, Mode=OneWay}" Width="20" Height="20" /><TextBlock AutomationProperties.AutomationId="Target.Busy" VerticalAlignment="Center" Text="{x:Bind ViewModel.Target.Busy.Text, Mode=OneWay}" /></StackPanel>
                        <ItemsControl AutomationProperties.AutomationId="Target.Notices" ItemsSource="{x:Bind ViewModel.Target.Notices}" ItemTemplate="{StaticResource LineTemplate}" />
                        <InfoBar AutomationProperties.AutomationId="Target.Error" AutomationProperties.Name="{x:Bind ViewModel.Target.Error, Mode=OneWay}" Severity="Error" IsOpen="True" IsClosable="False" Message="{x:Bind ViewModel.Target.Error, Mode=OneWay}"
                                 Visibility="{x:Bind ViewModel.Target.HasError, Mode=OneWay}" />
                    </StackPanel>

                    <!-- デプロイのウィザード（docs/design/desktop-wizard.md の 3。入力は「設定」の ViewModel、計画と実行はデプロイの ViewModel） -->
                    <StackPanel x:Name="WizardPanel" Tag="wizard" Spacing="12" MaxWidth="900" HorizontalAlignment="Left" Visibility="Collapsed">
                        <TextBlock AutomationProperties.AutomationId="Panel.Wizard" Style="{StaticResource SubtitleTextBlockStyle}" Text="新しくデプロイ" />
                        <TextBlock AutomationProperties.AutomationId="Wizard.Step" Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.Wizard.StepText, Mode=OneWay}" />
                        <!-- 完了の表示（登録した後。docs/design/desktop-wizard.md の 3、Q4・Q13・No.70）: 進み具合と結果、続けて・新規 -->
                        <StackPanel AutomationProperties.AutomationId="Wizard.Completed" Spacing="12" Visibility="{x:Bind ViewModel.Wizard.IsCompleted, Mode=OneWay}">
                            <TextBlock AutomationProperties.AutomationId="Wizard.CompletedText" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" Text="{x:Bind ViewModel.Wizard.CompletedText, Mode=OneWay}" />
                            <TextBlock AutomationProperties.AutomationId="Wizard.Error" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCautionBrush}" Text="{x:Bind ViewModel.Deployment.Error, Mode=OneWay}"
                                       Visibility="{x:Bind ViewModel.Deployment.HasError, Mode=OneWay}" />
                            <ContentControl AutomationProperties.AutomationId="Wizard.Job" Content="{x:Bind ViewModel.Wizard.RegisteredJob, Mode=OneWay}" ContentTemplate="{StaticResource JobSummaryTemplate}" HorizontalContentAlignment="Stretch" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button AutomationProperties.AutomationId="Wizard.ShowJob" Content="{x:Bind ViewModel.Wizard.ShowJobText, Mode=OneWay}" Command="{x:Bind ViewModel.Wizard.ShowJobCommand}" Style="{StaticResource AccentButtonStyle}" />
                                <Button AutomationProperties.AutomationId="Wizard.Continue" Content="続けてデプロイ（今の設定で ① から）" Command="{x:Bind ViewModel.Wizard.ContinueCommand}" />
                                <Button AutomationProperties.AutomationId="Wizard.NewDeployment" Content="新規デプロイ（初期値から）" Command="{x:Bind ViewModel.Wizard.NewDeploymentCommand}" />
                            </StackPanel>
                        </StackPanel>
                        <!-- どの画面にも出す（完了の表示を除く）: ①〜④のすべての入力の Markdown のコピーと、初期値に戻す（docs/design/desktop-settings.md） -->
                        <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ViewModel.Wizard.IsEditing, Mode=OneWay}">
                            <Button AutomationProperties.AutomationId="Settings.CopyMarkdown" Content="設定を Markdown でコピー" Command="{x:Bind ViewModel.Settings.CopyMarkdownCommand}" />
                            <CheckBox AutomationProperties.AutomationId="Settings.IncludePasswords" Content="パスワードも含める" IsChecked="{x:Bind ViewModel.Settings.IncludePasswordsInCopy, Mode=TwoWay}" />
                            <Button AutomationProperties.AutomationId="Settings.Reset" Content="初期値に戻す" Command="{x:Bind ViewModel.Settings.ResetCommand}" />
                        </StackPanel>
                        <TextBlock AutomationProperties.AutomationId="Settings.Message" Text="{x:Bind ViewModel.Settings.Message, Mode=OneWay}" TextWrapping="Wrap" />

                        <!-- ① 対象 -->
                        <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.Wizard.IsTarget, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ComboBox AutomationProperties.AutomationId="Settings.Template" Header="テンプレート" MinWidth="240" ItemsSource="{x:Bind ViewModel.Settings.Templates}" DisplayMemberPath="Name"
                                          SelectedItem="{x:Bind ViewModel.Settings.SelectedTemplate, Mode=OneWay}" SelectionChanged="OnTemplateChanged" />
                                <Button AutomationProperties.AutomationId="Settings.ApplyTemplate" Content="テンプレートから入力" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.Settings.ApplyTemplateCommand}" />
                                <Button AutomationProperties.AutomationId="Settings.DeleteTemplate" Content="テンプレートを削除" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.Settings.DeleteTemplateCommand}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ComboBox AutomationProperties.AutomationId="Target.Subscription" Header="サブスクリプション" MinWidth="480" ItemsSource="{x:Bind ViewModel.Target.Subscriptions}"
                                          SelectedItem="{x:Bind ViewModel.Target.SelectedSubscription, Mode=OneWay}" SelectionChanged="OnSubscriptionChanged"
                                          DisplayMemberPath="Display" />
                                <Button AutomationProperties.AutomationId="Target.Reload" Content="読み直す" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.Target.LoadCommand}" />
                            </StackPanel>
                            <TextBox AutomationProperties.AutomationId="Target.ResourceGroup" Header="リソースグループ名（無ければ作成します）" Text="{x:Bind ViewModel.Target.ResourceGroup, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxWidth="480" HorizontalAlignment="Left" Width="480" />
                            <TextBox AutomationProperties.AutomationId="Target.AppName" Header="アプリ名（リソース名の接頭辞）" Text="{x:Bind ViewModel.Target.AppName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="480" HorizontalAlignment="Left" />
                            <TextBlock AutomationProperties.AutomationId="Wizard.ActiveJobNotice" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCautionBrush}" Text="{x:Bind ViewModel.Wizard.ActiveJobNotice, Mode=OneWay}"
                                       Visibility="{x:Bind ViewModel.Wizard.HasActiveJobNotice, Mode=OneWay}" />
                            <TextBox AutomationProperties.AutomationId="Target.Location" Header="リージョン" Text="{x:Bind ViewModel.Target.Location, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="480" HorizontalAlignment="Left" />
                        </StackPanel>

                        <!-- ② DB -->
                        <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.Wizard.IsDb, Mode=OneWay}">
                            <ComboBox AutomationProperties.AutomationId="Settings.DbType" Header="DB 種別" ItemsSource="{x:Bind vm:SettingsViewModel.DbTypes}"
                                      SelectedItem="{x:Bind ViewModel.Settings.DbType, Mode=OneWay}" SelectionChanged="OnDbTypeChanged" Width="240" />
                            <TextBox AutomationProperties.AutomationId="Settings.DbName" Header="DB 名" Text="{x:Bind ViewModel.Settings.DbName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="480" HorizontalAlignment="Left" />
                            <TextBox AutomationProperties.AutomationId="Settings.TtTag" Header="timetracker イメージのタグ（空なら既定のタグ）" PlaceholderText="{x:Bind ViewModel.Settings.DefaultTag, Mode=OneWay}"
                                      Text="{x:Bind ViewModel.Settings.TtTag, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="480" HorizontalAlignment="Left" />
                            <ComboBox AutomationProperties.AutomationId="Settings.PersistDb" Header="DB のデータ" ItemsSource="{x:Bind vm:SettingsViewModel.PersistDbOptions}" DisplayMemberPath="Label"
                                      SelectedItem="{x:Bind ViewModel.Settings.PersistDb, Mode=OneWay}" SelectionChanged="OnPersistDbChanged" MinWidth="480" />
                        </StackPanel>

                        <!-- ③ パスワード -->
                        <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.Wizard.IsPasswords, Mode=OneWay}">
                            <TextBlock TextWrapping="Wrap" Text="パスワードは保存しません（アプリを終了すると消えます。テンプレートにも保存しません）。" />
                            <PasswordBox AutomationProperties.AutomationId="Settings.DbPassword" Header="DB のパスワード（8 文字以上）" Password="{x:Bind ViewModel.Settings.DbPassword, Mode=TwoWay}" Width="480" HorizontalAlignment="Left" />
                            <PasswordBox AutomationProperties.AutomationId="Settings.TrackerPassword" Header="Timetracker のパスワード（8 文字以上）" Password="{x:Bind ViewModel.Settings.TrackerPassword, Mode=TwoWay}" Width="480" HorizontalAlignment="Left" />
                        </StackPanel>

                        <!-- ④ スペックと利用可能期限 -->
                        <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.Wizard.IsSpec, Mode=OneWay}">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="CPU（vCPU）とメモリ（Gi）" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBox AutomationProperties.AutomationId="Settings.TtCpu" Header="Timetracker の CPU" Text="{x:Bind ViewModel.Settings.TtCpu, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="150" />
                                <TextBox Header="Timetracker のメモリ" Text="{x:Bind ViewModel.Settings.TtMemoryGi, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="150" />
                                <TextBox Header="DB の CPU" Text="{x:Bind ViewModel.Settings.DbCpu, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="150" />
                                <TextBox Header="DB のメモリ" Text="{x:Bind ViewModel.Settings.DbMemoryGi, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="150" />
                                <TextBox Header="Redis の CPU" Text="{x:Bind ViewModel.Settings.RedisCpu, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="150" />
                                <TextBox Header="Redis のメモリ" Text="{x:Bind ViewModel.Settings.RedisMemoryGi, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="150" />
                            </StackPanel>
                            <ComboBox AutomationProperties.AutomationId="Settings.Expiry" Header="利用可能期限日" ItemsSource="{x:Bind vm:SettingsViewModel.ExpiryOptions}" DisplayMemberPath="Label"
                                      SelectedItem="{x:Bind ViewModel.Settings.Expiry, Mode=OneWay}" SelectionChanged="OnExpiryChanged" MinWidth="480" />
                            <DatePicker AutomationProperties.AutomationId="Settings.ExpiryDate" Header="期限日" Date="{x:Bind ViewModel.Settings.ExpiryDate, Mode=TwoWay}"
                                      Visibility="{x:Bind ViewModel.Settings.IsExpiryDate, Mode=OneWay}" />
                            <TextBlock AutomationProperties.AutomationId="Settings.ExpiryNotice" TextWrapping="Wrap" Text="{x:Bind ViewModel.Settings.ExpiryNotice}" />
                        </StackPanel>

                        <!-- ⑤ 確認と実行（開くと計画を作る） -->
                        <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.Wizard.IsConfirm, Mode=OneWay}">
                            <TextBlock TextWrapping="Wrap" Text="「計画」は Azure を読むだけで、変更しません。内容を確かめてから「今すぐ実行」か「予定に追加」を押してください。" />
                            <Button AutomationProperties.AutomationId="Deploy.Plan" Content="計画し直す" Command="{x:Bind ViewModel.Deployment.PlanCommand}" />
                            <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ViewModel.Deployment.Busy.IsBusy, Mode=OneWay}"><ProgressRing IsActive="{x:Bind ViewModel.Deployment.Busy.IsBusy, Mode=OneWay}" Width="20" Height="20" /><TextBlock AutomationProperties.AutomationId="Deploy.Busy" VerticalAlignment="Center" Text="{x:Bind ViewModel.Deployment.Busy.Text, Mode=OneWay}" /></StackPanel>
                            <InfoBar AutomationProperties.AutomationId="Deploy.Error" AutomationProperties.Name="{x:Bind ViewModel.Deployment.Error, Mode=OneWay}" Severity="Error" IsOpen="True" IsClosable="False" Message="{x:Bind ViewModel.Deployment.Error, Mode=OneWay}"
                                      Visibility="{x:Bind ViewModel.Deployment.HasError, Mode=OneWay}" />
                            <StackPanel Spacing="8" Visibility="{x:Bind local:Ui.IfTrue(ViewModel.Deployment.HasPlan), Mode=OneWay}">
                                <ItemsControl AutomationProperties.AutomationId="Deploy.Operations" ItemsSource="{x:Bind ViewModel.Deployment.Operations}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:OperationRow">
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="{x:Bind Action}" /><TextBlock Text="  " /><TextBlock Text="{x:Bind Name}" /><TextBlock Text="（" /><TextBlock Text="{x:Bind Resource}" /><TextBlock Text="）" /></StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{x:Bind ViewModel.Deployment.PersistDbText, Mode=OneWay}" />
                                <TextBlock AutomationProperties.AutomationId="Deploy.Expiry" Text="{x:Bind ViewModel.Deployment.ExpiryText, Mode=OneWay}" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind ViewModel.Deployment.PermissionText, Mode=OneWay}" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind ViewModel.Deployment.EstimatedDuration, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind local:Ui.Time(ViewModel.Deployment.ExpiresAt), Mode=OneWay}" />
                                <ItemsControl AutomationProperties.AutomationId="Deploy.Blockers" ItemsSource="{x:Bind ViewModel.Deployment.Blockers}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" ItemTemplate="{StaticResource LineTemplate}" />
                                <ItemsControl ItemsSource="{x:Bind ViewModel.Deployment.Warnings}" Foreground="{ThemeResource SystemFillColorCautionBrush}" ItemTemplate="{StaticResource LineTemplate}" />
                                <CheckBox AutomationProperties.AutomationId="Deploy.DataLossAck" Content="DB のデータが失われることを理解しました" IsChecked="{x:Bind ViewModel.Deployment.DataLossAcknowledged, Mode=TwoWay}"
                                          Visibility="{x:Bind local:Ui.IfTrue(ViewModel.Deployment.RequiresDataLossAck), Mode=OneWay}" />
                                <Button AutomationProperties.AutomationId="Deploy.Start" Content="今すぐ実行" Command="{x:Bind ViewModel.Deployment.StartCommand}" Style="{StaticResource AccentButtonStyle}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <DatePicker AutomationProperties.AutomationId="Deploy.ScheduleDate" Header="予定の日付" Date="{x:Bind ViewModel.Deployment.Schedule.Date, Mode=TwoWay}" />
                                    <TimePicker AutomationProperties.AutomationId="Deploy.ScheduleTime" Header="時刻" ClockIdentifier="24HourClock" Time="{x:Bind ViewModel.Deployment.Schedule.TimeOfDay, Mode=TwoWay}" />
                                    <Button AutomationProperties.AutomationId="Deploy.Schedule" Content="予定に追加" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.Deployment.ScheduleCommand}" />
                                </StackPanel>
                                <CheckBox AutomationProperties.AutomationId="Deploy.KeepSchedule" Content="予定をアプリの終了・再起動の後も残す（パスワードを暗号化してこの PC に保存）" IsChecked="{x:Bind ViewModel.Deployment.KeepScheduleAfterRestart, Mode=TwoWay}"
                                          Visibility="{x:Bind ViewModel.Deployment.CanKeepSchedule}" />
                                <TextBlock AutomationProperties.AutomationId="Deploy.Blocked" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCautionBrush}" Text="{x:Bind ViewModel.Deployment.BlockedText, Mode=OneWay}"
                                           Visibility="{x:Bind ViewModel.Deployment.IsBlocked, Mode=OneWay}" />
                                <TextBlock AutomationProperties.AutomationId="Deploy.ScheduleNote" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.Deployment.ScheduleNote, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBox AutomationProperties.AutomationId="Settings.TemplateName" Header="テンプレートの名前" Width="240" Text="{x:Bind ViewModel.Settings.TemplateName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button AutomationProperties.AutomationId="Settings.SaveTemplate" Content="この設定をテンプレートとして保存（パスワードは保存しません）" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.Settings.SaveTemplateCommand}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- この画面の誤りと警告（⑤ ではすべて）と、戻る・次へ（完了の表示では出さない） -->
                        <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.Wizard.IsEditing, Mode=OneWay}">
                        <ItemsControl AutomationProperties.AutomationId="Wizard.Errors" ItemsSource="{x:Bind ViewModel.Wizard.StepErrors}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" ItemTemplate="{StaticResource LineTemplate}" />
                        <ItemsControl AutomationProperties.AutomationId="Wizard.Warnings" ItemsSource="{x:Bind ViewModel.Wizard.StepWarnings}" Foreground="{ThemeResource SystemFillColorCautionBrush}" ItemTemplate="{StaticResource LineTemplate}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button AutomationProperties.AutomationId="Wizard.Back" Content="戻る" Command="{x:Bind ViewModel.Wizard.BackCommand}" />
                            <Button AutomationProperties.AutomationId="Wizard.Next" Content="次へ" Command="{x:Bind ViewModel.Wizard.NextCommand}" Style="{StaticResource AccentButtonStyle}" />
                            <TextBlock AutomationProperties.AutomationId="Wizard.Blocked" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCautionBrush}" Text="{x:Bind ViewModel.Wizard.BlockedText, Mode=OneWay}" />
                        </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- 実行状況（今すぐ実行・今すぐ削除の後と、一覧の「状態を確認」から開く。docs/design/desktop-wizard.md の 2） -->
                    <StackPanel x:Name="StatusPanel" Tag="status" Spacing="12" MaxWidth="900" HorizontalAlignment="Left" Visibility="Collapsed">
                        <TextBlock AutomationProperties.AutomationId="Panel.Status" Style="{StaticResource SubtitleTextBlockStyle}" Text="実行状況" />
                        <Button AutomationProperties.AutomationId="Status.BackToList" Content="{x:Bind ViewModel.ReturnText, Mode=OneWay}" Click="OnBackFromStatus" />
                        <ContentControl AutomationProperties.AutomationId="Status.Job" Content="{x:Bind ViewModel.StatusJob, Mode=OneWay}" ContentTemplate="{StaticResource JobRowTemplate}"
                                        Visibility="{x:Bind ViewModel.HasStatusJob, Mode=OneWay}" />
                        <Button AutomationProperties.AutomationId="Deploy.OpenEndpoint" Content="Timetracker を開く" Command="{x:Bind ViewModel.OpenEndpointCommand}" />
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Azure の状態" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button AutomationProperties.AutomationId="Status.Refresh" Content="読み直す" Command="{x:Bind ViewModel.Status.RefreshCommand}" />
                            <Button AutomationProperties.AutomationId="Status.Copy" Content="Markdown でコピー" Command="{x:Bind ViewModel.Status.CopyCommand}" />
                        </StackPanel>
                        <TextBlock AutomationProperties.AutomationId="Status.Message" Text="{x:Bind ViewModel.Status.Message, Mode=OneWay}" />
                        <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ViewModel.Status.Busy.IsBusy, Mode=OneWay}"><ProgressRing IsActive="{x:Bind ViewModel.Status.Busy.IsBusy, Mode=OneWay}" Width="20" Height="20" /><TextBlock AutomationProperties.AutomationId="Status.Busy" VerticalAlignment="Center" Text="{x:Bind ViewModel.Status.Busy.Text, Mode=OneWay}" /></StackPanel>
                        <InfoBar AutomationProperties.AutomationId="Status.Error" AutomationProperties.Name="{x:Bind ViewModel.Status.Error, Mode=OneWay}" Severity="Error" IsOpen="True" IsClosable="False" Message="{x:Bind ViewModel.Status.Error, Mode=OneWay}"
                                 Visibility="{x:Bind ViewModel.Status.HasError, Mode=OneWay}" />
                        <TextBlock AutomationProperties.AutomationId="Status.Summary" Text="{x:Bind ViewModel.Status.Summary, Mode=OneWay}" />
                        <TextBlock AutomationProperties.AutomationId="Status.Note" Text="{x:Bind ViewModel.Status.Note, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                        <TextBlock AutomationProperties.AutomationId="Status.Persistence" Text="{x:Bind ViewModel.Status.PersistenceText, Mode=OneWay}" TextWrapping="Wrap" />
                        <HyperlinkButton Content="{x:Bind ViewModel.Status.Endpoint, Mode=OneWay}" NavigateUri="{x:Bind ViewModel.Status.Endpoint, Mode=OneWay}"
                                         Visibility="{x:Bind ViewModel.Status.HasEndpoint, Mode=OneWay}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Status.Apps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:AppStateRow">
                                    <StackPanel Margin="0,4">
                                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Role}" /><TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text=": " /><TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Name}" /></StackPanel>
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="{x:Bind State}" /><TextBlock Text="、" /><TextBlock Text="{x:Bind Resources}" /><TextBlock Text="、" /><TextBlock Text="{x:Bind Image}" /></StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- デプロイの一覧（Azure から集める。docs/design/desktop-jobs.md の 6.3・6.4） -->
                    <StackPanel x:Name="DeploymentsPanel" Tag="deployments" Spacing="12" MaxWidth="1100" HorizontalAlignment="Left" Visibility="Collapsed">
                        <TextBlock AutomationProperties.AutomationId="Panel.Deployments" Style="{StaticResource SubtitleTextBlockStyle}" Text="デプロイの一覧" />
                        <TextBlock TextWrapping="Wrap" Text="サインインしたアカウントで読めるサブスクリプションから、本ツールでデプロイした環境（別の PC・CLI・MCP サーバーでデプロイしたものを含む）を読みます。パスワードは「パスワードを表示」を押したときだけ Azure から読み、PC には保存しません。" />
                        <Button AutomationProperties.AutomationId="Deployments.Load" Content="読み込む" Command="{x:Bind ViewModel.Deployments.LoadCommand}" />
                        <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ViewModel.Deployments.Busy.IsBusy, Mode=OneWay}"><ProgressRing IsActive="{x:Bind ViewModel.Deployments.Busy.IsBusy, Mode=OneWay}" Width="20" Height="20" /><TextBlock AutomationProperties.AutomationId="Deployments.Busy" VerticalAlignment="Center" Text="{x:Bind ViewModel.Deployments.Busy.Text, Mode=OneWay}" /></StackPanel>
                        <InfoBar AutomationProperties.AutomationId="Deployments.Error" AutomationProperties.Name="{x:Bind ViewModel.Deployments.Error, Mode=OneWay}" Severity="Error" IsOpen="True" IsClosable="False" Message="{x:Bind ViewModel.Deployments.Error, Mode=OneWay}"
                                 Visibility="{x:Bind ViewModel.Deployments.HasError, Mode=OneWay}" />
                        <ItemsControl AutomationProperties.AutomationId="Deployments.Notices" ItemsSource="{x:Bind ViewModel.Deployments.Notices}" ItemTemplate="{StaticResource LineTemplate}" />
                        <!-- 選んだ行への操作（docs/design/desktop-wizard.md の 7） -->
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock AutomationProperties.AutomationId="Deployments.Selection" VerticalAlignment="Center" Text="{x:Bind ViewModel.Deployments.SelectionText, Mode=OneWay}" />
                            <CheckBox AutomationProperties.AutomationId="Deployments.BatchNoExpiry" Content="期限なし" IsChecked="{x:Bind ViewModel.Deployments.BatchNoExpiry, Mode=TwoWay}" VerticalAlignment="Center" />
                            <DatePicker AutomationProperties.AutomationId="Deployments.BatchExpiryDate" Date="{x:Bind ViewModel.Deployments.BatchExpiryDate, Mode=TwoWay}"
                                        IsEnabled="{x:Bind local:Ui.Not(ViewModel.Deployments.BatchNoExpiry), Mode=OneWay}" />
                            <Button AutomationProperties.AutomationId="Deployments.ChangeExpiry" Content="期限を変える" Command="{x:Bind ViewModel.Deployments.ChangeSelectedExpiryCommand}" />
                            <Button AutomationProperties.AutomationId="Deployments.Delete" Content="削除…" Command="{x:Bind ViewModel.Deployments.DeleteSelectedCommand}" />
                            <Button AutomationProperties.AutomationId="Deployments.ClearSelection" Content="選択を外す" Command="{x:Bind ViewModel.Deployments.ClearSelectionCommand}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ViewModel.Deployments.BatchBusy.IsBusy, Mode=OneWay}"><ProgressRing IsActive="{x:Bind ViewModel.Deployments.BatchBusy.IsBusy, Mode=OneWay}" Width="16" Height="16" /><TextBlock VerticalAlignment="Center" Text="{x:Bind ViewModel.Deployments.BatchBusy.Text, Mode=OneWay}" /></StackPanel>
                        <TextBlock AutomationProperties.AutomationId="Deployments.BatchMessage" Text="{x:Bind ViewModel.Deployments.BatchMessage, Mode=OneWay}" TextWrapping="Wrap" />

                        <!-- 表: 見出しを押すと並べ替え、「▽」で絞り込み。複数の行を選べる -->
                        <Grid ColumnSpacing="4" Margin="40,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" /><ColumnDefinition Width="150" /><ColumnDefinition Width="130" /><ColumnDefinition Width="140" />
                                <ColumnDefinition Width="140" /><ColumnDefinition Width="130" /><ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Button AutomationProperties.AutomationId="Deployments.SortSubscription" Content="{x:Bind ViewModel.Deployments.SubscriptionHeader, Mode=OneWay}" Tag="Subscription" Click="OnSortDeployments" Style="{StaticResource HeaderButtonStyle}" />
                                <Button AutomationProperties.AutomationId="Deployments.FilterSubscription" Content="▽" Style="{StaticResource HeaderButtonStyle}">
                                    <Button.Flyout><Flyout><StackPanel Spacing="8">
                                        <ComboBox AutomationProperties.AutomationId="Deployments.SubscriptionFilter" Header="サブスクリプション" ItemsSource="{x:Bind ViewModel.Deployments.SubscriptionFilters}" Width="260"
                                                  DisplayMemberPath="Label" SelectedItem="{x:Bind ViewModel.Deployments.SubscriptionFilter, Mode=OneWay}" SelectionChanged="OnSubscriptionFilterChanged" />
                                        <Button AutomationProperties.AutomationId="Deployments.SubscriptionFilterClose" Content="閉じる" Click="OnCloseFlyout" />
                                    </StackPanel></Flyout></Button.Flyout>
                                </Button>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button AutomationProperties.AutomationId="Deployments.SortResourceGroup" Content="{x:Bind ViewModel.Deployments.ResourceGroupHeader, Mode=OneWay}" Tag="ResourceGroup" Click="OnSortDeployments" Style="{StaticResource HeaderButtonStyle}" />
                                <Button AutomationProperties.AutomationId="Deployments.FilterResourceGroup" Content="▽" Style="{StaticResource HeaderButtonStyle}">
                                    <Button.Flyout><Flyout><StackPanel Spacing="8">
                                        <TextBox AutomationProperties.AutomationId="Deployments.ResourceGroupFilter" Header="リソースグループ名（一部でよい）" Width="260"
                                                 Text="{x:Bind ViewModel.Deployments.ResourceGroupFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button AutomationProperties.AutomationId="Deployments.ResourceGroupFilterClose" Content="閉じる" Click="OnCloseFlyout" />
                                    </StackPanel></Flyout></Button.Flyout>
                                </Button>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button AutomationProperties.AutomationId="Deployments.SortAppName" Content="{x:Bind ViewModel.Deployments.AppNameHeader, Mode=OneWay}" Tag="AppName" Click="OnSortDeployments" Style="{StaticResource HeaderButtonStyle}" />
                                <Button AutomationProperties.AutomationId="Deployments.FilterAppName" Content="▽" Style="{StaticResource HeaderButtonStyle}">
                                    <Button.Flyout><Flyout><StackPanel Spacing="8">
                                        <TextBox AutomationProperties.AutomationId="Deployments.AppNameFilter" Header="アプリ名（一部でよい）" Width="260"
                                                 Text="{x:Bind ViewModel.Deployments.AppNameFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button AutomationProperties.AutomationId="Deployments.AppNameFilterClose" Content="閉じる" Click="OnCloseFlyout" />
                                    </StackPanel></Flyout></Button.Flyout>
                                </Button>
                            </StackPanel>
                            <StackPanel Grid.Column="3" Orientation="Horizontal">
                                <Button AutomationProperties.AutomationId="Deployments.SortState" Content="{x:Bind ViewModel.Deployments.StateHeader, Mode=OneWay}" Tag="State" Click="OnSortDeployments" Style="{StaticResource HeaderButtonStyle}" />
                                <Button AutomationProperties.AutomationId="Deployments.FilterState" Content="▽" Style="{StaticResource HeaderButtonStyle}">
                                    <Button.Flyout><Flyout><StackPanel Spacing="8">
                                        <ComboBox AutomationProperties.AutomationId="Deployments.StateFilter" Header="状態" ItemsSource="{x:Bind vm:DeploymentStates.Filters}" DisplayMemberPath="Label" Width="260"
                                                  SelectedItem="{x:Bind ViewModel.Deployments.StateFilter, Mode=OneWay}" SelectionChanged="OnStateFilterChanged" />
                                        <Button AutomationProperties.AutomationId="Deployments.StateFilterClose" Content="閉じる" Click="OnCloseFlyout" />
                                    </StackPanel></Flyout></Button.Flyout>
                                </Button>
                            </StackPanel>
                            <StackPanel Grid.Column="4" Orientation="Horizontal">
                                <Button AutomationProperties.AutomationId="Deployments.SortExpiry" Content="{x:Bind ViewModel.Deployments.ExpiryHeader, Mode=OneWay}" Tag="ExpiresAt" Click="OnSortDeployments" Style="{StaticResource HeaderButtonStyle}" />
                                <Button AutomationProperties.AutomationId="Deployments.FilterExpiry" Content="▽" Style="{StaticResource HeaderButtonStyle}">
                                    <Button.Flyout><Flyout><StackPanel Spacing="8">
                                        <ComboBox AutomationProperties.AutomationId="Deployments.ExpiryFilter" Header="利用可能期限日" ItemsSource="{x:Bind vm:DeploymentListViewModel.ExpiryFilters}" DisplayMemberPath="Label" Width="260"
                                                  SelectedItem="{x:Bind ViewModel.Deployments.ExpiryFilter, Mode=OneWay}" SelectionChanged="OnExpiryFilterChanged" />
                                        <CalendarDatePicker AutomationProperties.AutomationId="Deployments.ExpiryFrom" Header="期限日（から）" Date="{x:Bind ViewModel.Deployments.ExpiryFrom, Mode=TwoWay}"
                                                            Visibility="{x:Bind ViewModel.Deployments.IsExpiryRange, Mode=OneWay}" />
                                        <CalendarDatePicker AutomationProperties.AutomationId="Deployments.ExpiryTo" Header="期限日（まで）" Date="{x:Bind ViewModel.Deployments.ExpiryTo, Mode=TwoWay}"
                                                            Visibility="{x:Bind ViewModel.Deployments.IsExpiryRange, Mode=OneWay}" />
                                        <Button AutomationProperties.AutomationId="Deployments.ExpiryFilterClose" Content="閉じる" Click="OnCloseFlyout" />
                                    </StackPanel></Flyout></Button.Flyout>
                                </Button>
                            </StackPanel>
                            <StackPanel Grid.Column="5" Orientation="Horizontal">
                                <Button AutomationProperties.AutomationId="Deployments.SortDeployed" Content="{x:Bind ViewModel.Deployments.DeployedHeader, Mode=OneWay}" Tag="DeployedAt" Click="OnSortDeployments" Style="{StaticResource HeaderButtonStyle}" />
                                <Button AutomationProperties.AutomationId="Deployments.FilterDeployed" Content="▽" Style="{StaticResource HeaderButtonStyle}">
                                    <Button.Flyout><Flyout><StackPanel Spacing="8">
                                        <CalendarDatePicker AutomationProperties.AutomationId="Deployments.DeployedFrom" Header="デプロイ日（から）" Date="{x:Bind ViewModel.Deployments.DeployedFrom, Mode=TwoWay}" />
                                        <CalendarDatePicker AutomationProperties.AutomationId="Deployments.DeployedTo" Header="デプロイ日（まで）" Date="{x:Bind ViewModel.Deployments.DeployedTo, Mode=TwoWay}" />
                                        <Button AutomationProperties.AutomationId="Deployments.DeployedFilterClose" Content="閉じる" Click="OnCloseFlyout" />
                                    </StackPanel></Flyout></Button.Flyout>
                                </Button>
                            </StackPanel>
                            <TextBlock Grid.Column="6" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" Text="ジョブ" />
                        </Grid>
                        <ListView x:Name="DeploymentsTable" AutomationProperties.AutomationId="Deployments.Rows" ItemsSource="{x:Bind ViewModel.Deployments.Rows}" SelectionMode="Multiple"
                                  SelectionChanged="OnDeploymentsSelectionChanged">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:DeploymentRowViewModel">
                                    <Grid ColumnSpacing="4" Padding="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200" /><ColumnDefinition Width="150" /><ColumnDefinition Width="130" /><ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="140" /><ColumnDefinition Width="130" /><ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind Subscription}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Subscription}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind ResourceGroup}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" AutomationProperties.AutomationId="Row.AppName" Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind AppName}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="3" AutomationProperties.AutomationId="Row.State" Text="{x:Bind StateText, Mode=OneWay}" TextWrapping="Wrap" ToolTipService.ToolTip="{x:Bind StateDetail, Mode=OneWay}" />
                                        <TextBlock Grid.Column="4" AutomationProperties.AutomationId="Row.Expiry" Text="{x:Bind ExpiryText, Mode=OneWay}" Foreground="{x:Bind local:Ui.ExpiryBrush(Level), Mode=OneWay}" TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="5" Text="{x:Bind DeployedText, Mode=OneWay}" />
                                        <TextBlock Grid.Column="6" AutomationProperties.AutomationId="Row.Job" Text="{x:Bind JobText, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button AutomationProperties.AutomationId="Deployments.Previous" Content="前のページ" Command="{x:Bind ViewModel.Deployments.PreviousPageCommand}" />
                            <Button AutomationProperties.AutomationId="Deployments.Next" Content="次のページ" Command="{x:Bind ViewModel.Deployments.NextPageCommand}" />
                            <TextBlock AutomationProperties.AutomationId="Deployments.Page" VerticalAlignment="Center" TextWrapping="Wrap" Text="{x:Bind ViewModel.Deployments.PageText, Mode=OneWay}" />
                            <ComboBox AutomationProperties.AutomationId="Deployments.PageSize" ItemsSource="{x:Bind vm:DeploymentListViewModel.PageSizes}"
                                      SelectedItem="{x:Bind ViewModel.Deployments.PageSize, Mode=OneWay}" SelectionChanged="OnPageSizeChanged" />
                            <TextBlock VerticalAlignment="Center" Text="件ずつ表示" />
                        </StackPanel>

                        <!-- 1 行だけ選んだときの詳細（選んだ行の値を ViewModel から直接結び付ける。テンプレートの ContentControl では、パスワードを読んだ後の表示が変わらなかった） -->
                        <Border AutomationProperties.AutomationId="Deployments.Detail" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="12"
                                Visibility="{x:Bind ViewModel.Deployments.HasCurrent, Mode=OneWay}">
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.Deployments.Current.AppName, Mode=OneWay}" />
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="（" /><TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.Deployments.Current.ResourceGroup, Mode=OneWay}" /><TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="）" />
                                </StackPanel>
                                <HyperlinkButton Content="{x:Bind ViewModel.Deployments.Current.Url, Mode=OneWay}" Command="{x:Bind ViewModel.Deployments.Current.OpenCommand, Mode=OneWay}" Visibility="{x:Bind ViewModel.Deployments.Current.HasUrl, Mode=OneWay}" Padding="0" />
                                <TextBlock AutomationProperties.AutomationId="Row.ExpiryWarning" Text="{x:Bind ViewModel.Deployments.Current.ExpiryWarning, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                           Visibility="{x:Bind ViewModel.Deployments.Current.HasExpiryWarning, Mode=OneWay}" />
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="{x:Bind ViewModel.Deployments.Current.DbTypeText, Mode=OneWay}" /><TextBlock Text="、" /><TextBlock Text="{x:Bind ViewModel.Deployments.Current.PersistenceText, Mode=OneWay}" /><TextBlock Text="、" />
                                    <TextBlock Text="{x:Bind ViewModel.Deployments.Current.SpecText, Mode=OneWay}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button AutomationProperties.AutomationId="Row.UseAsTarget" Content="対象に入れる" Command="{x:Bind ViewModel.Deployments.Current.UseAsTargetCommand, Mode=OneWay}" />
                                    <Button AutomationProperties.AutomationId="Row.CheckStatus" Content="{x:Bind ViewModel.Deployments.Current.CheckStatusText, Mode=OneWay}" Command="{x:Bind ViewModel.Deployments.Current.CheckStatusCommand, Mode=OneWay}" />
                                    <Button AutomationProperties.AutomationId="Row.ShowPasswords" Content="パスワードを表示" Command="{x:Bind ViewModel.Deployments.Current.ShowPasswordsCommand, Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.Deployments.Current.HasPasswords, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock VerticalAlignment="Center" Text="DB のパスワード:" /><TextBlock AutomationProperties.AutomationId="Row.DbPassword" VerticalAlignment="Center" IsTextSelectionEnabled="False" Text="{x:Bind ViewModel.Deployments.Current.DbPasswordText, Mode=OneWay}" />
                                        <Button Content="コピー" Command="{x:Bind ViewModel.Deployments.Current.CopyDbPasswordCommand, Mode=OneWay}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock VerticalAlignment="Center" Text="Timetracker のパスワード:" /><TextBlock AutomationProperties.AutomationId="Row.TrackerPassword" VerticalAlignment="Center" IsTextSelectionEnabled="False" Text="{x:Bind ViewModel.Deployments.Current.TrackerPasswordText, Mode=OneWay}" />
                                        <Button Content="コピー" Command="{x:Bind ViewModel.Deployments.Current.CopyTrackerPasswordCommand, Mode=OneWay}" />
                                    </StackPanel>
                                    <Button AutomationProperties.AutomationId="Row.TogglePasswords" Content="表示する・伏せる" Command="{x:Bind ViewModel.Deployments.Current.TogglePasswordsCommand, Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ViewModel.Deployments.Current.Busy.IsBusy, Mode=OneWay}"><ProgressRing IsActive="{x:Bind ViewModel.Deployments.Current.Busy.IsBusy, Mode=OneWay}" Width="16" Height="16" /><TextBlock VerticalAlignment="Center" Text="{x:Bind ViewModel.Deployments.Current.Busy.Text, Mode=OneWay}" /></StackPanel>
                                <TextBlock AutomationProperties.AutomationId="Row.Message" Text="{x:Bind ViewModel.Deployments.Current.Message, Mode=OneWay}" TextWrapping="Wrap" />
                                <TextBlock AutomationProperties.AutomationId="Row.Error" Text="{x:Bind ViewModel.Deployments.Current.Error, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                           Visibility="{x:Bind ViewModel.Deployments.Current.HasError, Mode=OneWay}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 削除（計画 → アプリ名の入力 → 実行） -->
                    <StackPanel x:Name="DeletePanel" Tag="delete" Spacing="12" MaxWidth="900" HorizontalAlignment="Left" Visibility="Collapsed">
                        <TextBlock AutomationProperties.AutomationId="Panel.Delete" Style="{StaticResource SubtitleTextBlockStyle}" Text="削除" />
                        <Button AutomationProperties.AutomationId="Delete.BackToList" Content="デプロイの一覧に戻る" Click="OnBackToList" />
                        <StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Text="対象:" /><TextBlock AutomationProperties.AutomationId="Delete.Target" Text="{x:Bind ViewModel.Target.SubscriptionDisplay, Mode=OneWay}" /><TextBlock Text=" / " /><TextBlock Text="{x:Bind ViewModel.Target.ResourceGroup, Mode=OneWay}" /><TextBlock Text=" / " /><TextBlock Text="{x:Bind ViewModel.Target.AppName, Mode=OneWay}" /></StackPanel>
                        <TextBlock TextWrapping="Wrap" Text="本ツールで作ったリソースだけを削除します。リソースグループは、「リソースグループも削除する」を選んだ場合だけ、中が空になれば削除します。" />
                        <CheckBox AutomationProperties.AutomationId="Delete.IncludeUntagged" Content="管理タグの無いものも対象にする" IsChecked="{x:Bind ViewModel.Deletion.IncludeUntagged, Mode=TwoWay}" />
                        <CheckBox AutomationProperties.AutomationId="Delete.KeepDbData" Content="DB のデータを残す（ストレージアカウントを削除しない。料金がかかり続けます）" IsChecked="{x:Bind ViewModel.Deletion.KeepDbData, Mode=TwoWay}" />
                        <CheckBox AutomationProperties.AutomationId="Delete.DeleteResourceGroup" Content="リソースグループも削除する（本ツールのリソースを削除した後に、中が空になる場合だけ。元に戻せません）" IsChecked="{x:Bind ViewModel.Deletion.DeleteResourceGroup, Mode=TwoWay}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button AutomationProperties.AutomationId="Delete.Plan" Content="計画し直す" Command="{x:Bind ViewModel.Deletion.PlanCommand}" />
                            <Button AutomationProperties.AutomationId="Delete.CopyPlan" Content="計画を Markdown でコピー" Command="{x:Bind ViewModel.Deletion.CopyPlanCommand}" />
                        </StackPanel>
                        <TextBlock AutomationProperties.AutomationId="Delete.Message" Text="{x:Bind ViewModel.Deletion.Message, Mode=OneWay}" />
                        <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ViewModel.Deletion.Busy.IsBusy, Mode=OneWay}"><ProgressRing IsActive="{x:Bind ViewModel.Deletion.Busy.IsBusy, Mode=OneWay}" Width="20" Height="20" /><TextBlock AutomationProperties.AutomationId="Delete.Busy" VerticalAlignment="Center" Text="{x:Bind ViewModel.Deletion.Busy.Text, Mode=OneWay}" /></StackPanel>
                        <InfoBar AutomationProperties.AutomationId="Delete.Error" AutomationProperties.Name="{x:Bind ViewModel.Deletion.Error, Mode=OneWay}" Severity="Error" IsOpen="True" IsClosable="False" Message="{x:Bind ViewModel.Deletion.Error, Mode=OneWay}"
                                 Visibility="{x:Bind ViewModel.Deletion.HasError, Mode=OneWay}" />
                        <StackPanel Spacing="8" Visibility="{x:Bind local:Ui.IfTrue(ViewModel.Deletion.HasPlan), Mode=OneWay}">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Deletion.Targets}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DeletionRow">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="{x:Bind Decision}" /><TextBlock Text="  " /><TextBlock Text="{x:Bind Name}" /><TextBlock Text="（" /><TextBlock Text="{x:Bind Resource}" /><TextBlock Text="） " /><TextBlock Text="{x:Bind Reason}" /></StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{x:Bind ViewModel.Deletion.KeptText, Mode=OneWay}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ViewModel.Deletion.Note, Mode=OneWay}" />
                            <ItemsControl AutomationProperties.AutomationId="Delete.Blockers" ItemsSource="{x:Bind ViewModel.Deletion.Blockers}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" ItemTemplate="{StaticResource LineTemplate}" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Deletion.Warnings}" Foreground="{ThemeResource SystemFillColorCautionBrush}" ItemTemplate="{StaticResource LineTemplate}" />
                            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.Deletion.NeedsAppNameConfirmation, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="確認のため、アプリ名「" /><TextBlock Text="{x:Bind ViewModel.Deletion.AppNameToConfirm, Mode=OneWay}" /><TextBlock Text="」を入力してください。" /></StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBox AutomationProperties.AutomationId="Delete.ConfirmAppName" Text="{x:Bind ViewModel.Deletion.ConfirmAppName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="320" HorizontalAlignment="Left" />
                                    <Button AutomationProperties.AutomationId="Delete.CopyAppName" Content="アプリ名をコピー" Command="{x:Bind ViewModel.Deletion.CopyAppNameCommand}" />
                                </StackPanel>
                                <Button AutomationProperties.AutomationId="Delete.Start" Content="今すぐ削除" Command="{x:Bind ViewModel.Deletion.StartCommand}" Style="{StaticResource AccentButtonStyle}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <DatePicker AutomationProperties.AutomationId="Delete.ScheduleDate" Header="予定の日付" Date="{x:Bind ViewModel.Deletion.Schedule.Date, Mode=TwoWay}" />
                                    <TimePicker AutomationProperties.AutomationId="Delete.ScheduleTime" Header="時刻" ClockIdentifier="24HourClock" Time="{x:Bind ViewModel.Deletion.Schedule.TimeOfDay, Mode=TwoWay}" />
                                    <Button AutomationProperties.AutomationId="Delete.Schedule" Content="予定に追加" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.Deletion.ScheduleCommand}" />
                                </StackPanel>
                                <TextBlock AutomationProperties.AutomationId="Delete.Blocked" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCautionBrush}" Text="{x:Bind ViewModel.Deletion.BlockedText, Mode=OneWay}"
                                           Visibility="{x:Bind ViewModel.Deletion.IsBlocked, Mode=OneWay}" />
                                <TextBlock AutomationProperties.AutomationId="Delete.ScheduleNote" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind vm:SystemStatusViewModel.DeletionScheduleNote}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- ローカル検証（Dry-run） -->
                    <StackPanel x:Name="DryRunPanel" Tag="dryrun" Spacing="12" MaxWidth="900" HorizontalAlignment="Left" Visibility="Collapsed">
                        <TextBlock AutomationProperties.AutomationId="Panel.DryRun" Style="{StaticResource SubtitleTextBlockStyle}" Text="ローカル検証（Dry-run）" />
                        <TextBlock TextWrapping="Wrap" Text="次の内容で docker-compose.yml と .env を保存します（「新しくデプロイ」と同じ入力です）。Azure には接続しません（サインインは不要です）。" />
                        <ComboBox AutomationProperties.AutomationId="DryRun.DbType" Header="DB 種別" ItemsSource="{x:Bind vm:SettingsViewModel.DbTypes}"
                                  SelectedItem="{x:Bind ViewModel.Settings.DbType, Mode=OneWay}" SelectionChanged="OnDbTypeChanged" Width="240" />
                        <TextBox AutomationProperties.AutomationId="DryRun.DbName" Header="DB 名" Text="{x:Bind ViewModel.Settings.DbName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="480" HorizontalAlignment="Left" />
                        <TextBox AutomationProperties.AutomationId="DryRun.TtTag" Header="timetracker イメージのタグ（空なら既定のタグ）" PlaceholderText="{x:Bind ViewModel.Settings.DefaultTag, Mode=OneWay}"
                                 Text="{x:Bind ViewModel.Settings.TtTag, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="480" HorizontalAlignment="Left" />
                        <PasswordBox AutomationProperties.AutomationId="DryRun.DbPassword" Header="DB のパスワード（8 文字以上）" Password="{x:Bind ViewModel.Settings.DbPassword, Mode=TwoWay}" Width="480" HorizontalAlignment="Left" />
                        <PasswordBox AutomationProperties.AutomationId="DryRun.TrackerPassword" Header="Timetracker のパスワード（8 文字以上）" Password="{x:Bind ViewModel.Settings.TrackerPassword, Mode=TwoWay}" Width="480" HorizontalAlignment="Left" />
                        <InfoBar Severity="Warning" IsOpen="True" IsClosable="False" Message="{x:Bind ViewModel.DryRun.EnvWarning}" />
                        <Button AutomationProperties.AutomationId="DryRun.Save" Content="保存先を選んで保存" Command="{x:Bind ViewModel.DryRun.SaveCommand}" Style="{StaticResource AccentButtonStyle}" />
                        <InfoBar AutomationProperties.AutomationId="DryRun.Error" AutomationProperties.Name="{x:Bind ViewModel.DryRun.Error, Mode=OneWay}" Severity="Error" IsOpen="True" IsClosable="False" Message="{x:Bind ViewModel.DryRun.Error, Mode=OneWay}"
                                 Visibility="{x:Bind ViewModel.DryRun.HasError, Mode=OneWay}" />
                        <ItemsControl AutomationProperties.AutomationId="DryRun.Warnings" ItemsSource="{x:Bind ViewModel.DryRun.Warnings}" Foreground="{ThemeResource SystemFillColorCautionBrush}" ItemTemplate="{StaticResource LineTemplate}" />
                        <ItemsControl AutomationProperties.AutomationId="DryRun.NextSteps" ItemsSource="{x:Bind ViewModel.DryRun.NextSteps}" ItemTemplate="{StaticResource LineTemplate}" />
                        <Button AutomationProperties.AutomationId="DryRun.OpenFolder" Content="フォルダーを開く" Command="{x:Bind ViewModel.DryRun.OpenFolderCommand}" />
                        <TextBox AutomationProperties.AutomationId="DryRun.Compose" Header="docker-compose.yml" Text="{x:Bind ViewModel.DryRun.ComposeContent, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                                 FontFamily="Consolas" MinHeight="200" Visibility="{x:Bind ViewModel.DryRun.HasComposeContent, Mode=OneWay}" />
                    </StackPanel>

                    <!-- ジョブの一覧（表。docs/design/desktop-wizard.md の 7） -->
                    <StackPanel x:Name="JobsPanel" Tag="jobs" Spacing="12" MaxWidth="1100" HorizontalAlignment="Left" Visibility="Collapsed">
                        <TextBlock AutomationProperties.AutomationId="Panel.Jobs" Style="{StaticResource SubtitleTextBlockStyle}" Text="ジョブの一覧（このアプリを終了すると消えます）" />
                        <TextBlock TextWrapping="Wrap" Text="このアプリで登録したデプロイ・削除です（予定・実行中・終わったもの）。行を選ぶと、まとめて取り消し・一時停止・再開・予定の変更ができます。1 行だけ選んで「詳細」（または行をダブルクリック）で、進み具合とログを見られます。" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock AutomationProperties.AutomationId="Jobs.Summary" VerticalAlignment="Center" Text="{x:Bind ViewModel.Queue.Summary, Mode=OneWay}" />
                            <TextBlock AutomationProperties.AutomationId="Jobs.Count" VerticalAlignment="Center" Text="{x:Bind ViewModel.JobList.CountText, Mode=OneWay}" />
                            <Button AutomationProperties.AutomationId="Jobs.ClearFinished" Content="終わったジョブを一覧から消す" Command="{x:Bind ViewModel.ClearFinishedCommand}" />
                        </StackPanel>
                        <!-- 選んだ行への操作 -->
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock AutomationProperties.AutomationId="Jobs.Selection" VerticalAlignment="Center" Text="{x:Bind ViewModel.JobList.SelectionText, Mode=OneWay}" />
                            <Button AutomationProperties.AutomationId="Jobs.Detail" Content="詳細" IsEnabled="{x:Bind ViewModel.JobList.HasCurrent, Mode=OneWay}" Click="OnShowJobDetail" />
                            <Button AutomationProperties.AutomationId="Jobs.CancelSelected" Content="取り消し" Command="{x:Bind ViewModel.JobList.CancelSelectedCommand}" />
                            <Button AutomationProperties.AutomationId="Jobs.PauseSelected" Content="一時停止" Command="{x:Bind ViewModel.JobList.PauseSelectedCommand}" />
                            <Button AutomationProperties.AutomationId="Jobs.ResumeSelected" Content="再開" Command="{x:Bind ViewModel.JobList.ResumeSelectedCommand}" />
                            <Button AutomationProperties.AutomationId="Jobs.ClearSelection" Content="選択を外す" Command="{x:Bind ViewModel.JobList.ClearSelectionCommand}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <DatePicker AutomationProperties.AutomationId="Jobs.ScheduleDate" Header="予定の日付" Date="{x:Bind ViewModel.JobList.Schedule.Date, Mode=TwoWay}" />
                            <TimePicker AutomationProperties.AutomationId="Jobs.ScheduleTime" Header="時刻" ClockIdentifier="24HourClock" Time="{x:Bind ViewModel.JobList.Schedule.TimeOfDay, Mode=TwoWay}" />
                            <Button AutomationProperties.AutomationId="Jobs.RescheduleSelected" Content="選んだジョブの予定を変える" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.JobList.RescheduleSelectedCommand}" />
                        </StackPanel>
                        <TextBlock AutomationProperties.AutomationId="Jobs.Message" Text="{x:Bind ViewModel.JobList.Message, Mode=OneWay}" TextWrapping="Wrap" />
                        <Grid ColumnSpacing="4" Margin="40,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" /><ColumnDefinition Width="220" /><ColumnDefinition Width="200" /><ColumnDefinition Width="110" /><ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" AutomationProperties.AutomationId="Jobs.SortKind" Content="{x:Bind ViewModel.JobList.KindHeader, Mode=OneWay}" Tag="Kind" Click="OnSortJobs" Style="{StaticResource HeaderButtonStyle}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button AutomationProperties.AutomationId="Jobs.SortTarget" Content="{x:Bind ViewModel.JobList.TargetHeader, Mode=OneWay}" Tag="Target" Click="OnSortJobs" Style="{StaticResource HeaderButtonStyle}" />
                                <Button AutomationProperties.AutomationId="Jobs.FilterTarget" Content="▽" Style="{StaticResource HeaderButtonStyle}">
                                    <Button.Flyout><Flyout><StackPanel Spacing="8">
                                        <TextBox AutomationProperties.AutomationId="Jobs.TargetFilter" Header="リソースグループ / アプリ名（一部でよい）" Width="260"
                                                 Text="{x:Bind ViewModel.JobList.TargetFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button AutomationProperties.AutomationId="Jobs.TargetFilterClose" Content="閉じる" Click="OnCloseFlyout" />
                                    </StackPanel></Flyout></Button.Flyout>
                                </Button>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button AutomationProperties.AutomationId="Jobs.SortState" Content="{x:Bind ViewModel.JobList.StateHeader, Mode=OneWay}" Tag="State" Click="OnSortJobs" Style="{StaticResource HeaderButtonStyle}" />
                                <Button AutomationProperties.AutomationId="Jobs.FilterState" Content="▽" Style="{StaticResource HeaderButtonStyle}">
                                    <Button.Flyout><Flyout><StackPanel Spacing="8">
                                        <ComboBox AutomationProperties.AutomationId="Jobs.StateFilter" Header="状態" ItemsSource="{x:Bind vm:JobListViewModel.Filters}" Width="220"
                                                  SelectedItem="{x:Bind ViewModel.JobList.Filter, Mode=OneWay}" SelectionChanged="OnJobFilterChanged" />
                                        <Button AutomationProperties.AutomationId="Jobs.StateFilterClose" Content="閉じる" Click="OnCloseFlyout" />
                                    </StackPanel></Flyout></Button.Flyout>
                                </Button>
                            </StackPanel>
                            <Button Grid.Column="3" AutomationProperties.AutomationId="Jobs.SortTime" Content="{x:Bind ViewModel.JobList.TimeHeader, Mode=OneWay}" Tag="Time" Click="OnSortJobs" Style="{StaticResource HeaderButtonStyle}" />
                            <TextBlock Grid.Column="4" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" Text="結果" />
                        </Grid>
                        <ListView x:Name="JobsList" AutomationProperties.AutomationId="Jobs.List" ItemsSource="{x:Bind ViewModel.JobList.Items}" SelectionMode="Multiple"
                                  SelectionChanged="OnJobsSelectionChanged" DoubleTapped="OnJobDoubleTapped">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:JobViewModel">
                                    <Grid ColumnSpacing="4" Padding="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" /><ColumnDefinition Width="220" /><ColumnDefinition Width="200" /><ColumnDefinition Width="110" /><ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" AutomationProperties.AutomationId="Job.Kind" Text="{x:Bind KindText}" />
                                        <TextBlock Grid.Column="1" AutomationProperties.AutomationId="Job.Target" Text="{x:Bind TargetText}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" AutomationProperties.AutomationId="Job.Status" Text="{x:Bind StatusText, Mode=OneWay}" TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="3" AutomationProperties.AutomationId="Job.Time" Text="{x:Bind TimeText, Mode=OneWay}" />
                                        <TextBlock Grid.Column="4" AutomationProperties.AutomationId="Job.Result" Text="{x:Bind ResultText, Mode=OneWay}" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>

                    <!-- まとめての削除（計画を並べ、件数を入力して確認。docs/design/desktop-wizard.md の 7、Q10） -->
                    <StackPanel x:Name="BatchDeletePanel" Tag="batchdelete" Spacing="12" MaxWidth="900" HorizontalAlignment="Left" Visibility="Collapsed">
                        <TextBlock AutomationProperties.AutomationId="Panel.BatchDelete" Style="{StaticResource SubtitleTextBlockStyle}" Text="まとめて削除" />
                        <Button AutomationProperties.AutomationId="BatchDelete.BackToList" Content="デプロイの一覧に戻る" Click="OnBackToList" />
                        <TextBlock TextWrapping="Wrap" Text="選んだデプロイごとに、本ツールで作ったリソースだけを削除します。下の指定は、すべてのデプロイに当てます。計画に誤りがあるもの・ジョブがあるものは外します。" />
                        <CheckBox AutomationProperties.AutomationId="BatchDelete.KeepDbData" Content="DB のデータを残す（ストレージアカウントを削除しない。料金がかかり続けます）" IsChecked="{x:Bind ViewModel.BatchDeletion.KeepDbData, Mode=TwoWay}" />
                        <CheckBox AutomationProperties.AutomationId="BatchDelete.DeleteResourceGroup" Content="リソースグループも削除する（本ツールのリソースを削除した後に、中が空になる場合だけ。元に戻せません）" IsChecked="{x:Bind ViewModel.BatchDeletion.DeleteResourceGroup, Mode=TwoWay}" />
                        <Button AutomationProperties.AutomationId="BatchDelete.Plan" Content="計画し直す" Command="{x:Bind ViewModel.BatchDeletion.PlanCommand}" />
                        <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ViewModel.BatchDeletion.Busy.IsBusy, Mode=OneWay}"><ProgressRing IsActive="{x:Bind ViewModel.BatchDeletion.Busy.IsBusy, Mode=OneWay}" Width="20" Height="20" /><TextBlock AutomationProperties.AutomationId="BatchDelete.Busy" VerticalAlignment="Center" Text="{x:Bind ViewModel.BatchDeletion.Busy.Text, Mode=OneWay}" /></StackPanel>
                        <ItemsControl AutomationProperties.AutomationId="BatchDelete.Items" ItemsSource="{x:Bind ViewModel.BatchDeletion.Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:BatchDeletionItem">
                                    <StackPanel Spacing="2" Margin="0,4">
                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Title}" />
                                        <TextBlock Text="{x:Bind Summary}" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind Excluded}" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCautionBrush}" Visibility="{x:Bind IsExcluded}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <InfoBar AutomationProperties.AutomationId="BatchDelete.Error" AutomationProperties.Name="{x:Bind ViewModel.BatchDeletion.Error, Mode=OneWay}" Severity="Error" IsOpen="True" IsClosable="False" Message="{x:Bind ViewModel.BatchDeletion.Error, Mode=OneWay}"
                                 Visibility="{x:Bind ViewModel.BatchDeletion.HasError, Mode=OneWay}" />
                        <TextBlock AutomationProperties.AutomationId="BatchDelete.ConfirmText" Text="{x:Bind ViewModel.BatchDeletion.ConfirmText, Mode=OneWay}" TextWrapping="Wrap" />
                        <TextBox AutomationProperties.AutomationId="BatchDelete.ConfirmCount" Header="削除する件数" Text="{x:Bind ViewModel.BatchDeletion.ConfirmCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="160" HorizontalAlignment="Left" />
                        <Button AutomationProperties.AutomationId="BatchDelete.Start" Content="今すぐ削除" Command="{x:Bind ViewModel.BatchDeletion.StartCommand}" Style="{StaticResource AccentButtonStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <DatePicker AutomationProperties.AutomationId="BatchDelete.ScheduleDate" Header="予定の日付" Date="{x:Bind ViewModel.BatchDeletion.Schedule.Date, Mode=TwoWay}" />
                            <TimePicker AutomationProperties.AutomationId="BatchDelete.ScheduleTime" Header="時刻" ClockIdentifier="24HourClock" Time="{x:Bind ViewModel.BatchDeletion.Schedule.TimeOfDay, Mode=TwoWay}" />
                            <Button AutomationProperties.AutomationId="BatchDelete.Schedule" Content="予定に追加" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.BatchDeletion.ScheduleCommand}" />
                        </StackPanel>
                        <TextBlock AutomationProperties.AutomationId="BatchDelete.Blocked" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCautionBrush}" Text="{x:Bind ViewModel.BatchDeletion.BlockedText, Mode=OneWay}"
                                   Visibility="{x:Bind ViewModel.BatchDeletion.IsBlocked, Mode=OneWay}" />
                        <TextBlock AutomationProperties.AutomationId="BatchDelete.ScheduleNote" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind vm:SystemStatusViewModel.DeletionScheduleNote}" />
                    </StackPanel>

                    <!-- 設定（アプリ全体。メニューの下。No.63） -->
                    <StackPanel x:Name="SettingsPanel" Tag="settings" Spacing="12" MaxWidth="900" HorizontalAlignment="Left" Visibility="Collapsed">
                        <TextBlock AutomationProperties.AutomationId="Panel.AppSettings" Style="{StaticResource SubtitleTextBlockStyle}" Text="設定" />
                        <TextBlock TextWrapping="Wrap" Text="対象が違うジョブは同時に実行します。実行中のジョブは、今の手順が終わってから止まります（作りかけのリソースは、もう一度実行すると続きから処理します）。" />
                        <ComboBox AutomationProperties.AutomationId="Settings.Concurrency" Header="同時に実行するジョブの数（対象が違うもの）" ItemsSource="{x:Bind jobs:JobQueue.ConcurrencyChoices}"
                                  SelectedItem="{x:Bind ViewModel.Queue.MaxConcurrency, Mode=OneWay}" SelectionChanged="OnConcurrencyChanged" Width="240" />
                        <TextBlock AutomationProperties.AutomationId="Settings.Resident" TextWrapping="Wrap" Text="終わっていないジョブか、利用可能期限日のあるデプロイがあるときにウィンドウを閉じると、通知領域に残って続けます（終了は通知領域のアイコンのメニューから）。ジョブが終わると通知します。Windows のサインアウト・再起動・シャットダウンではアプリが終わります（削除の予定は、次にアプリを起動してサインインしたときに戻します。デプロイの予定は消えます）。PC のスリープ中は実行せず、予定の時刻を過ぎていれば、動けるようになってからすぐ実行します。" />

                        <!-- Windows との連携（docs/design/desktop-jobs.md の 6.6、No.67。画面を開いたときに読み直す） -->
                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,16,0,0">
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Windows との連携" />
                            <Button AutomationProperties.AutomationId="Settings.RefreshSystem" Content="状態を読み直す" Command="{x:Bind ViewModel.Integration.RefreshCommand}" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Windows のサインイン時に、通知領域で起動する（利用可能期限の確認と削除、前回の削除の予定を戻すため）" />
                            <TextBlock AutomationProperties.AutomationId="Settings.StartupStatus" TextWrapping="Wrap" Text="{x:Bind ViewModel.Startup.StatusText, Mode=OneWay}" />
                            <TextBlock AutomationProperties.AutomationId="Settings.LastStartup" TextWrapping="Wrap" Text="{x:Bind ViewModel.Integration.LastStartupText, Mode=OneWay}" />
                            <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind vm:StartupSettingViewModel.Explanation}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button AutomationProperties.AutomationId="Settings.StartupToggle" Content="{x:Bind ViewModel.Startup.ToggleText, Mode=OneWay}" Command="{x:Bind ViewModel.Startup.ToggleCommand}" />
                                <Button AutomationProperties.AutomationId="Settings.OpenStartupApps" Content="Windows のスタートアップ アプリの設定を開く" Command="{x:Bind ViewModel.Integration.OpenStartupSettingsCommand}" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="通知" />
                            <TextBlock AutomationProperties.AutomationId="Settings.NotificationStatus" TextWrapping="Wrap" Text="{x:Bind ViewModel.Integration.NotificationText, Mode=OneWay}" />
                            <Button AutomationProperties.AutomationId="Settings.OpenNotifications" Content="Windows の通知の設定を開く" Command="{x:Bind ViewModel.Integration.OpenNotificationSettingsCommand}" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="常駐と予定" />
                            <TextBlock AutomationProperties.AutomationId="Settings.CloseBehavior" TextWrapping="Wrap" Text="{x:Bind ViewModel.Integration.CloseBehaviorText, Mode=OneWay}" />
                            <TextBlock AutomationProperties.AutomationId="Settings.ScheduledJobs" TextWrapping="Wrap" Text="{x:Bind ViewModel.Integration.ScheduledText, Mode=OneWay}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="診断用のログ" Margin="0,16,0,0" />
                        <TextBlock TextWrapping="Wrap" Text="サインインや読み込みがうまくいかないときの調査に使います。この PC にだけ保存し（7 日で削除）、パスワードとトークンは書きません。" />
                        <TextBlock AutomationProperties.AutomationId="Settings.LogDirectory" IsTextSelectionEnabled="True" Text="{x:Bind ViewModel.LogDirectory}" />
                        <Button AutomationProperties.AutomationId="Settings.OpenLogFolder" Content="ログのフォルダーを開く" Command="{x:Bind ViewModel.OpenLogFolderCommand}" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </NavigationView>
    </Grid>
</Window>
