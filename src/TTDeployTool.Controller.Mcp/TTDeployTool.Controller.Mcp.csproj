<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ttdeploytool-mcp</AssemblyName>
    <RootNamespace>TTDeployTool.Controller.Mcp</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TTDeployTool.Controller.Mcp.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- HTTP トランスポートで ASP.NET Core を使う -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\TTDeployTool.Application\TTDeployTool.Application.csproj" />
    <ProjectReference Include="..\TTDeployTool.Infrastructure.Azure\TTDeployTool.Infrastructure.Azure.csproj" />
    <ProjectReference Include="..\TTDeployTool.Domain\TTDeployTool.Domain.csproj" />
    <ProjectReference Include="..\TTDeployTool.Common\TTDeployTool.Common.csproj" />
  </ItemGroup>
</Project>
