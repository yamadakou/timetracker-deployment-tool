<Project Sdk="Microsoft.NET.Sdk.Razor">
  <!--
    Blazor Hybrid 版の WPF のホスト（docs/design/desktop/desktop-blazor-hybrid.md の 3・8・16。Q1 の A）。窓・BlazorWebView・通知領域・起動だけを持ち、
    画面は TTDeployTool.Controller.Desktop.Blazor（Razor）、状態と操作は Desktop.Core（WinUI 3 のアプリと同じ）。
    Windows との連携（WAM のサインイン・Windows の通知・サインイン時の起動・DPAPI・クリップボード）は、WinUI 3 のアプリの実装のファイルをそのまま使う（リンク）。
    テスト用のビルド（/p:UiTestMock=true）だけ、サインインと Azure などを Fixtures のモックにする（Fixtures はこのときだけ参照する）。
    引数 check と報告のファイルで起動すると、Windows との連携を確かめた結果を JSON に書いて終了する（トークンは取らない）。
    Windows でしかビルドできないため TTDeployTool.sln には入れず、CI の blazor-prototype-windows ジョブでビルドする
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <UseWPF>true</UseWPF>
    <RootNamespace>TTDeployTool.Controller.Desktop.Blazor.Wpf</RootNamespace>
    <AssemblyName>ttdeploytool-blazor</AssemblyName>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>..\TTDeployTool.Controller.Desktop\Assets\TrayIcon.ico</ApplicationIcon>
    <!-- WinUI 3 のアプリと同じく、利用者の PC に .NET のランタイムを求めない（起動時間・メモリを同じ条件で比べる） -->
    <SelfContained>true</SelfContained>
    <!-- 通知（AppNotificationManager）のための Windows App SDK を、アプリと一緒に置く（Windows App SDK のランタイムを PC に求めない） -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!--
      Windows App SDK を参照すると、WebView2 のパッケージは WinUI 用の参照（CsWinRT の projection）だけにし、BlazorWebView が使う
      Microsoft.Web.WebView2.Wpf.dll を出力に入れない（Microsoft.Web.WebView2 の build/Common.targets）。WPF 用の参照に戻す（試作の CI で分かった）
    -->
    <WebView2EnableCsWinRTProjection>false</WebView2EnableCsWinRTProjection>
    <!-- 1 つだけ起動するため、App.xaml が生成する Main を使わず、Program.cs の Main で起動する（WinUI のアプリと同じ） -->
    <StartupObject>TTDeployTool.Controller.Desktop.Blazor.Wpf.Program</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="DesktopClientId" Value="$(DesktopClientId)" />
  </ItemGroup>
  <PropertyGroup Condition="'$(UiTestMock)' == 'true'">
    <DefineConstants>$(DefineConstants);UITEST_MOCK</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(UiTestMock)' == 'true'">
    <ProjectReference Include="..\TTDeployTool.Controller.Desktop.Fixtures\TTDeployTool.Controller.Desktop.Fixtures.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Azure.Identity.Broker" Version="1.7.0" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Wpf" Version="10.0.120" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup>
    <!-- WPF の暗黙の using には System.IO が無い（リンクした WinUI のアプリのファイルは使う） -->
    <Using Include="System.IO" />
  </ItemGroup>
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>
  <ItemGroup>
    <!-- WinUI 3 のアプリの Windows の実装（変えずに使う） -->
    <Compile Include="..\TTDeployTool.Controller.Desktop\Services\WamSignInService.cs" Link="Linked\WamSignInService.cs" />
    <Compile Include="..\TTDeployTool.Controller.Desktop\Services\AppNotificationService.cs" Link="Linked\AppNotificationService.cs" />
    <Compile Include="..\TTDeployTool.Controller.Desktop\Services\StartupTaskService.cs" Link="Linked\StartupTaskService.cs" />
    <Compile Include="..\TTDeployTool.Controller.Desktop\Services\DpapiSecretProtector.cs" Link="Linked\DpapiSecretProtector.cs" />
    <Compile Include="..\TTDeployTool.Controller.Desktop\Services\ClipboardService.cs" Link="Linked\ClipboardService.cs" />
    <!-- .wapproj は、ビルドの出力からパッケージに入れるため、画面の入り口（index.html）を出力にも置く -->
    <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\TTDeployTool.Controller.Desktop\Assets\TrayIcon.ico" Link="TrayIcon.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\TTDeployTool.Controller.Desktop.Blazor\TTDeployTool.Controller.Desktop.Blazor.csproj" />
  </ItemGroup>
</Project>
