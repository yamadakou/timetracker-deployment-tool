<Window x:Class="TTDeployTool.Controller.Desktop.Blazor.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Wpf;assembly=Microsoft.AspNetCore.Components.WebView.Wpf"
        xmlns:shell="clr-namespace:TTDeployTool.Controller.Desktop.Blazor.Shell;assembly=TTDeployTool.Controller.Desktop.Blazor"
        Title="TTDeployTool" Width="1400" Height="900">
    <!-- サービス（services）は、App が MainViewModel を組み立てた後に MainWindow.Initialize で入れる -->
    <blazor:BlazorWebView x:Name="WebView" HostPage="wwwroot\index.html" Services="{DynamicResource services}">
        <blazor:BlazorWebView.RootComponents>
            <blazor:RootComponent Selector="#app" ComponentType="{x:Type shell:DesktopShell}" />
        </blazor:BlazorWebView.RootComponents>
    </blazor:BlazorWebView>
</Window>
