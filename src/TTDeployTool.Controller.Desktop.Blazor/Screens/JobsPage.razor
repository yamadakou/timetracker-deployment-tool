@inherits ViewModelComponent
@inject IJSRuntime JS

@* ジョブの一覧（WinUI の画面の JobsPanel。docs/design/desktop/desktop-wizard.md の 7）。サインインしていなくても開ける（過去の記録を見るため。
   ジョブの操作はサインインするまで押せない。No.78）。1 行だけ選んで「詳細」か、行のダブルクリックで、実行状況の画面を開く *@
<section class="tt-page" data-id="Panel.Jobs">
    <div class="tt-page-head">
        <div>
            <h1>ジョブの一覧</h1>
            @* 説明は 1 行にし、詳しくは畳む（UX の見直し C、2026-11-16） *@
            <p class="tt-page-sub" data-id="Jobs.Lead">このアプリで登録したデプロイ・削除です。行をダブルクリックすると、進み具合・結果・ログを見られます。</p>
            <details class="tt-page-more" data-id="Jobs.More">
                <summary>詳しく</summary>
                <p class="tt-page-sub">予定・実行中・終わったものを並べます。終わったジョブは、アプリを終了しても記録として残します（180 日・500 件まで）。行を選ぶと、まとめて取り消し・一時停止・再開・予定の変更・記録から削除ができます（行の右クリックでも操作できます）。「記録から削除」は、この一覧と PC の記録を消すだけで、Azure のリソースは消しません（Azure から消すときは、デプロイの一覧の「Azure から削除…」）。</p>
            </details>
        </div>
    </div>
    @* 件数のカード（推奨のデザイン。押すとその条件で絞り込む。もう一度押すと外す） *@
    <div class="tt-cards">
        <StatCard Id="Jobs.Card.Running" IconName="jobs" Tone="info" Value="Jobs.RunningCount" Label="実行中" Action="絞り込む" Pressed="Jobs.QuickFilter == JobQuickFilter.Running" OnClick="() => Toggle(JobQuickFilter.Running)" />
        <StatCard Id="Jobs.Card.Pending" IconName="clock" Tone="info" Value="Jobs.PendingCount" Label="予定・待機中・一時停止" Action="絞り込む" Pressed="Jobs.QuickFilter == JobQuickFilter.Pending" OnClick="() => Toggle(JobQuickFilter.Pending)" />
        <StatCard Id="Jobs.Card.Failed" IconName="bell" Tone="critical" Value="Jobs.RecentFailedCount" Label="失敗（7 日以内）" Action="絞り込む"
                  Pressed="Jobs.QuickFilter == JobQuickFilter.RecentFailed" OnClick="() => Toggle(JobQuickFilter.RecentFailed)" />
        <StatCard Id="Jobs.Card.Succeeded" IconName="check" Tone="ok" Value="Jobs.RecentSucceededCount" Label="完了（7 日以内）" Action="絞り込む"
                  Pressed="Jobs.QuickFilter == JobQuickFilter.RecentSucceeded" OnClick="() => Toggle(JobQuickFilter.RecentSucceeded)" />
    </div>
    <div class="tt-bar">
        <span data-id="Jobs.Count">@Jobs.CountText</span>
        <CommandButton Id="Jobs.DeleteFinishedRecords" Command="Jobs.DeleteFinishedRecordsCommand" Text="終わったジョブを記録から削除" Disabled="!SignedIn" />
    </div>
    @if (!SignedIn)
    {
        <p data-id="Jobs.SignInNote">サインインするまで、ジョブの操作（取り消し・一時停止・再開・予定の変更・記録から削除）はできません。一覧と詳細は見られます。</p>
    }
    @* 選んだ行への操作 *@
    <div class="tt-bar tt-surface tt-commandbar">
        <span data-id="Jobs.Selection">@Jobs.SelectionText</span>
        <button type="button" data-id="Jobs.Detail" disabled="@(!Jobs.HasCurrent)" @onclick="() => Open(Jobs.Current!)">詳細</button>
        @* 1 行だけ選んだ、終わったデプロイのジョブの設定を「新しくデプロイ」に読み込む（オーナーの依頼、2026-11-03） *@
        <button type="button" data-id="Jobs.Redeploy" disabled="@(Jobs.Current?.CanRedeploy != true || !SignedIn)" @onclick="() => Jobs.Current!.RedeployCommand.ExecuteAsync()">この設定で新しくデプロイ</button>
        <CommandButton Id="Jobs.CancelSelected" Command="Jobs.CancelSelectedCommand" Text="取り消し" Disabled="!SignedIn" />
        <CommandButton Id="Jobs.PauseSelected" Command="Jobs.PauseSelectedCommand" Text="一時停止" Disabled="!SignedIn" />
        <CommandButton Id="Jobs.ResumeSelected" Command="Jobs.ResumeSelectedCommand" Text="再開" Disabled="!SignedIn" />
        <CommandButton Id="Jobs.DeleteSelectedRecords" Command="Jobs.DeleteSelectedRecordsCommand" Text="記録から削除" Disabled="!SignedIn" />
        <CommandButton Id="Jobs.ClearSelection" Command="Jobs.ClearSelectionCommand" Text="選択を外す" />
    </div>
    <div class="tt-bar">
        <DateTimeInput Id="Jobs.Schedule" Date="Jobs.Schedule.Date" DateChanged="d => Jobs.Schedule.Date = d" Time="Jobs.Schedule.TimeOfDay" TimeChanged="t => Jobs.Schedule.TimeOfDay = t" Disabled="!SignedIn" />
        <CommandButton Id="Jobs.RescheduleSelected" Command="Jobs.RescheduleSelectedCommand" Text="選んだジョブの予定を変える" Disabled="!SignedIn" />
    </div>
    <p data-id="Jobs.Message">@Jobs.Message</p>
    <Message Id="Jobs.RedeployNote" Text="@Jobs.Current?.RedeployNote" Kind="MessageKind.Caution" />
    <FilterBar TItem="JobViewModel" Filters="Jobs.Filters" Name="jobs" />
    @* 行の右クリックに、コピーの後に行の操作を並べる（オーナーの依頼、2026-11-14）。行のダブルクリックで詳細（実行状況）を開く *@
    <DataTable TRow="JobViewModel" TItem="JobViewModel" Source="_source" Label="ジョブの一覧" Clipboard="Clipboard" OnRowDoubleClick="Open"
               RowMenu="jobs => Jobs.MenuFor(jobs, Open, SignedIn)" />
    <Pager Name="jobs" Previous="Jobs.PreviousPageCommand" Next="Jobs.NextPageCommand" PageSizes="JobListViewModel.PageSizes"
           PageSize="Jobs.PageSize" PageSizeChanged="size => Jobs.PageSize = size" Text="@Jobs.CountText" />
</section>

@code {
    private TableSource<JobViewModel, JobViewModel> _source = default!;

    [Parameter, EditorRequired]
    public MainViewModel Model { get; set; } = default!;

    [Parameter]
    public IClipboardService? Clipboard { get; set; }

    private JobListViewModel Jobs => Model.JobList;

    private bool SignedIn => Model.SignIn.IsSignedIn;

    protected override void OnInitialized()
    {
        _source = TableSources.Jobs(Jobs, Model.JobsLayout);
        Watch(Jobs, Jobs.Schedule, Model.SignIn);
        Jobs.RescheduleRequested += FocusSchedule;
    }

    protected override void OnDispose() => Jobs.RescheduleRequested -= FocusSchedule;

    // 右クリックの「予定を変える…」: 予定の日付に移る
    private void FocusSchedule() => _ = JsModule.InvokeQuietlyAsync(JsModule.ImportAsync(JS), "focusSelector", "[data-id='Jobs.ScheduleDate']");

    // 件数のカード: 押したカードの条件で絞り込む。同じカードをもう一度押すと外す
    private void Toggle(JobQuickFilter filter) => Jobs.QuickFilter = Jobs.QuickFilter == filter ? JobQuickFilter.All : filter;

    // 実行状況の画面で開く（WinUI の画面の「詳細」と、行のダブルクリック）
    private Task Open(JobViewModel job) => Model.OpenJobAsync(job);
}
