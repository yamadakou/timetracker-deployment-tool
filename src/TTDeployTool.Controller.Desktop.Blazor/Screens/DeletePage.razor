@inherits ViewModelComponent

@* Azure から削除（計画 → アプリ名の入力 → 実行。WinUI の画面の DeletePanel） *@
<section class="tt-page tt-narrow" data-id="Panel.Delete">
    <h1>Azure から削除</h1>
    <button type="button" data-id="Delete.BackToList" @onclick="() => Back.InvokeAsync(Pages.Deployments)">デプロイの一覧に戻る</button>
    <p>対象: <span data-id="Delete.Target">@Model.Target.SubscriptionDisplay</span> / @Model.Target.ResourceGroup / @Model.Target.AppName</p>
    <p>本ツールで作ったリソースだけを削除します。リソースグループは、「リソースグループも削除する」を選んだ場合だけ、中が空になれば削除します。</p>
    <CheckField Id="Delete.IncludeUntagged" Label="管理タグの無いものも対象にする" Value="Deletion.IncludeUntagged" ValueChanged="v => Deletion.IncludeUntagged = v" />
    <CheckField Id="Delete.KeepDbData" Label="DB のデータを残す（ストレージアカウントを削除しない。料金がかかり続けます）" Value="Deletion.KeepDbData" ValueChanged="v => Deletion.KeepDbData = v" />
    <CheckField Id="Delete.DeleteResourceGroup" Label="リソースグループも削除する（本ツールのリソースを削除した後に、中が空になる場合だけ。元に戻せません）"
                Value="Deletion.DeleteResourceGroup" ValueChanged="v => Deletion.DeleteResourceGroup = v" />
    <div class="tt-bar">
        <CommandButton Id="Delete.Plan" Command="Deletion.PlanCommand" Text="計画し直す" />
        <CommandButton Id="Delete.CopyPlan" Command="Deletion.CopyPlanCommand" Text="計画を Markdown でコピー" />
    </div>
    <p data-id="Delete.Message">@Deletion.Message</p>
    <BusyView Id="Delete.Busy" State="Deletion.Busy" />
    <Message Id="Delete.Error" Text="@Deletion.Error" />
    @if (Deletion.HasPlan)
    {
        <ul class="tt-lines" data-id="Delete.Targets">
            @foreach (var target in Deletion.Targets)
            {
                <li>@target.Decision  @target.Name（@target.Resource） @target.Reason</li>
            }
        </ul>
        <p>@Deletion.KeptText</p>
        <p>@Deletion.Note</p>
        <Lines Id="Delete.Blockers" Items="Deletion.Blockers" Css="tt-critical" />
        <Lines Id="Delete.Warnings" Items="Deletion.Warnings" Css="tt-caution" />
        @if (Deletion.NeedsAppNameConfirmation)
        {
            <p>確認のため、アプリ名「@Deletion.AppNameToConfirm」を入力してください。</p>
            <div class="tt-bar">
                <TextInput Id="Delete.ConfirmAppName" Label="アプリ名" Value="@Deletion.ConfirmAppName" ValueChanged="v => Deletion.ConfirmAppName = v" />
                <CommandButton Id="Delete.CopyAppName" Command="Deletion.CopyAppNameCommand" Text="アプリ名をコピー" />
            </div>
            <CommandButton Id="Delete.Start" Command="Deletion.StartCommand" Text="今すぐ削除" Css="tt-primary" />
            <div class="tt-bar">
                <DateTimeInput Id="Delete.Schedule" Date="Deletion.Schedule.Date" DateChanged="d => Deletion.Schedule.Date = d"
                               Time="Deletion.Schedule.TimeOfDay" TimeChanged="t => Deletion.Schedule.TimeOfDay = t" />
                <CommandButton Id="Delete.Schedule" Command="Deletion.ScheduleCommand" Text="予定に追加" />
            </div>
            <Message Id="Delete.Blocked" Text="@Deletion.BlockedText" Kind="MessageKind.Caution" />
            <p class="tt-subtle" data-id="Delete.ScheduleNote">@SystemStatusViewModel.DeletionScheduleNote</p>
        }
    }
</section>

@code {
    [Parameter, EditorRequired]
    public MainViewModel Model { get; set; } = default!;

    [Parameter]
    public EventCallback<string> Back { get; set; }

    private DeletionViewModel Deletion => Model.Deletion;

    protected override void OnInitialized() =>
        Watch(Model.Target, Deletion, Deletion.Targets, Deletion.Blockers, Deletion.Warnings, Deletion.Schedule);
}
