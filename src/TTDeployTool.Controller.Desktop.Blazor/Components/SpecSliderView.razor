@using TTDeployTool.Controller.Desktop.Core.Pricing
@inherits ViewModelComponent

@* スペックのスライダー（オーナーの依頼、2026-11-13: TimeTracker・DB・Redis の 3 つとも案 B のスライダー）。CPU を選ぶと、メモリは CPU の 2 倍 *@
<div class="tt-spec" data-id="@($"Spec.{Spec.Name}")">
    <div class="tt-spec-head"><span class="tt-strong">@Spec.Name</span><span class="tt-spec-value" data-id="@($"Spec.{Spec.Name}.Value")">@Spec.Text</span></div>
    <input type="range" min="0" max="@Spec.MaxStep" step="1" value="@Spec.Step" aria-label="@($"{Spec.Name} の CPU")" data-id="@($"Spec.{Spec.Name}.Slider")"
           @oninput="e => Spec.Step = int.Parse((string)e.Value!, System.Globalization.CultureInfo.InvariantCulture)" />
    <div class="tt-ticks">
        @foreach (var label in Spec.Labels)
        {
            <span>@label</span>
        }
    </div>
    <div class="tt-spec-foot">
        <span>メモリは CPU の 2 倍（Container Apps の組み合わせ）</span>
        <span data-id="@($"Spec.{Spec.Name}.Cost")">@(Cost.Lines.FirstOrDefault(l => l.Name == Spec.Name)?.Amount is { } amount ? $"期限まで 約 {amount}" : null)</span>
    </div>
    <Message Id="@($"Spec.{Spec.Name}.Note")" Text="@Spec.Note" Kind="MessageKind.Caution" />
</div>

@code {
    [Parameter, EditorRequired]
    public SpecSlider Spec { get; set; } = default!;

    [Parameter, EditorRequired]
    public CostEstimateViewModel Cost { get; set; } = default!;

    protected override void OnParametersSet() => Watcher.Sync([Spec, Cost, Cost.Lines]);
}
