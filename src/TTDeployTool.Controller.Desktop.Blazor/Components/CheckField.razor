@* チェックボックス *@
<label class="tt-check-field">
    <input type="checkbox" data-id="@Id" checked="@Value" disabled="@Disabled" @onchange="e => ValueChanged.InvokeAsync((bool)e.Value!)" />
    <span>@Label</span>
</label>

@code {
    [Parameter]
    public string Id { get; set; } = "";

    [Parameter]
    public string Label { get; set; } = "";

    [Parameter]
    public bool Value { get; set; }

    [Parameter]
    public EventCallback<bool> ValueChanged { get; set; }

    [Parameter]
    public bool Disabled { get; set; }
}
