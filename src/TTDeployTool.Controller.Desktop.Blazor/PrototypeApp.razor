@inherits ViewModelComponent

@* 試作の画面の根（desktop-blazor-hybrid.md の 7）。モックのアカウントでサインインし、デプロイの一覧を読んでから表を出す *@
<div class="tt-app">
    <header class="tt-header">
        <span class="tt-title">TTDeployTool（Blazor Hybrid の試作）</span>
        <nav class="tt-tabs" role="tablist" aria-label="画面">
            <button type="button" role="tab" aria-selected="@(_page == Pages.Deployments ? "true" : "false")" @onclick="() => _page = Pages.Deployments">デプロイの一覧</button>
            <button type="button" role="tab" aria-selected="@(_page == Pages.Jobs ? "true" : "false")" @onclick="() => _page = Pages.Jobs">ジョブの一覧</button>
        </nav>
        <span class="tt-account" data-account>@Session.ViewModel.SignIn.AccountDisplay</span>
    </header>
    <main>
        @if (!_ready)
        {
            <p role="status">モックのデータを読んでいます…</p>
        }
        else if (_page == Pages.Deployments)
        {
            <DeploymentsPage Model="Session.ViewModel.Deployments" Layout="Session.ViewModel.DeploymentsLayout" Clipboard="Session.Clipboard" />
        }
        else
        {
            <JobsPage Model="Session.ViewModel.JobList" Layout="Session.ViewModel.JobsLayout" Clipboard="Session.Clipboard" />
        }
    </main>
</div>

@code {
    private string _page = Pages.Deployments;
    private bool _ready;

    [Inject]
    private PrototypeSession Session { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        Watch(Session.ViewModel.SignIn);
        await Session.StartAsync();
        _ready = true;
    }
}
